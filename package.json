{
  "name": "opengea-wiki",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "kit": "node scripts/with-kit.mjs astro dev",
    "build": "astro build && pagefind --site dist",
    "build:kit": "node scripts/with-kit.mjs astro build",
    "preview": "astro preview",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check:types": "astro check",
    "check:site": "node scripts/check-site.mjs",
    "verify": "npm test && npm run check:types && npm run build:kit && npm run check:site && npm run build && npm run check:site"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.11",
    "pagefind": "^1.6.0",
    "playwright-core": "^1.57.0",
    "typescript": "^6.0.3"
  }
}

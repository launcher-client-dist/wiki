---
/**
 * The one 404 page GitHub Pages serves, for any missing path (with a real 404 status). It is the Portuguese one;
 * on a missing /en/... path it swaps itself for the English 404 (/en/404/) in place, keeping the URL and the status.
 * Not indexed, not in the sitemap or search.
 */
import NotFound from "../components/NotFound.astro";
---
<NotFound lang="pt">
  <script is:inline slot="head">
    (function () {
      if (!/^\/en(\/|$)/.test(location.pathname)) return;
      var root = document.documentElement;
      root.style.visibility = "hidden";
      fetch("/en/404/").then(function (r) { if (!r.ok) throw r; return r.text(); }).then(function (html) {
        var next = new DOMParser().parseFromString(html, "text/html").documentElement;
        document.replaceChild(document.importNode(next, true), document.documentElement);
        // scripts moved in this way don't run: re-create them so they do
        document.querySelectorAll("script:not([type='application/ld+json'])").forEach(function (old) {
          var s = document.createElement("script");
          for (var i = 0; i < old.attributes.length; i++) s.setAttribute(old.attributes[i].name, old.attributes[i].value);
          s.textContent = old.textContent;
          old.replaceWith(s);
        });
      }).catch(function () { root.style.visibility = ""; });
    })();
  </script>
</NotFound>

---
/**
 * The NPC list: a grid of renders (and a table view): name, where, what it sells and buys (item kinds as their game
 * icons), hours. Filters: town, sells (item kind), buys (item kind), services, has hours. A quest-only NPC shows its
 * name and render only (its place and trade are its page's spoiler).
 */
import PageShell from "../../../components/layout/PageShell.astro";
import PixelArt from "../../../components/ui/PixelArt.astro";
import IconSlot from "../../../components/ui/IconSlot.astro";
import RenderSlot from "../../../components/ui/RenderSlot.astro";
import DataTable from "../../../components/data/DataTable.astro";
import DataRow from "../../../components/data/DataRow.astro";
import DataCell from "../../../components/data/DataCell.astro";
import { ui, fill } from "../../../i18n/index.ts";
import { HREFLANG, LANGS, LOCALE, type Lang } from "../../../lib/i18n.ts";
import { homePath, SECTIONS, sectionAlternates, sectionPath } from "../../../lib/routes.ts";
import { siteData } from "../../../lib/site-registry.ts";
import { gameHour } from "../../../lib/monsters/data.ts";
import { hasHours, openShifts, serviceKeys, tradeKinds, type NpcData } from "../../../lib/npcs/data.ts";
import { displayName } from "../../../lib/names.ts";
import uiSizes from "../../../data/ui-icons.json";
const UI = uiSizes as Record<string, number[]>;

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang, npcs: SECTIONS.npc.slug[lang] } }));
}
const lang = Astro.params.lang as Lang;
const t = ui(lang);
const tn = t.npc;
const ti = t.item;
const { registry, npcs, items } = await siteData();
const catOf = new Map(items.map((i) => [i.id, i.category as string]));
const NAMES = new Map(npcs.map((n) => [n.id, displayName(registry.require(n.ref).name, "npc", lang)]));
const rows = [...npcs].sort((a, b) => NAMES.get(a.id)!.name.localeCompare(NAMES.get(b.id)!.name, lang));
const num = (v: number) => v.toLocaleString(LOCALE[lang]);
const slugTown = (en: string) => en.toLowerCase().replace(/[^a-z0-9]+/g, "-");
/** Only the shifts a player meets without a quest (a quest's place stays in its page's spoiler). */
const townsOf = (n: NpcData) => (n.spoiler ? [] : [...new Set(openShifts(n).map((s) => s.place.town.en))]);
const TOWN = new Map<string, { label: string; n: number }>();
for (const n of npcs) for (const s of n.spoiler ? [] : openShifts(n)) TOWN.set(s.place.town.en, { label: s.place.town[lang], n: 0 });
for (const n of npcs) for (const tw of townsOf(n)) TOWN.get(tw)!.n++;
const townOpts = [...TOWN.entries()].sort((a, b) => b[1].n - a[1].n || a[1].label.localeCompare(b[1].label, lang));
const sells = (n: NpcData) => (n.spoiler ? [] : tradeKinds(n, (i) => catOf.get(i), "sells"));
const buys = (n: NpcData) => (n.spoiler ? [] : tradeKinds(n, (i) => catOf.get(i), "buys"));
const catOpts = (pick: (n: NpcData) => string[]) => {
  const c = new Map<string, number>();
  for (const n of npcs) for (const k of pick(n)) c.set(k, (c.get(k) ?? 0) + 1);
  return [...c.entries()].sort((a, b) => b[1] - a[1]).map(([k, count]) => ({ value: k, label: ti.category[k as "weapon"] ?? k, count, icon: `cat-${k}` }));
};
const SERVICE_ICON = { travel: "src-map", trainer: "class", heal: "stat-health" } as const;
const SERVICE_LABEL = { travel: tn.travel, trainer: fill(tn.trainer, { c: "" }).trim(), heal: ti.category.potion } as const;
/** A game icon's file and size at a whole scale (drawn in the template). */
const icon = (name: string, scale = 2) => { const sz = UI[name] ?? [9, 9]; return { src: `/ui/${name}.png`, w: sz[0]! * scale, h: sz[1]! * scale }; };
---
<PageShell lang={lang} title={tn.listTitle} description={tn.listDescription} alternates={sectionAlternates("npc")} current="npc"
  searchable={{ kind: "npc" }}
  crumbs={[{ label: t.home, href: homePath(lang) }, { label: tn.listTitle, href: sectionPath("npc", lang) }]}>
  <div class="container npcs-page">
    <header class="page-head">
      <PixelArt kind="npc" size={64} />
      <div>
        <h1>{tn.listTitle}</h1>
        <p>{tn.listIntro}</p>
      </div>
    </header>
    <DataTable id="npcs" lang={lang} caption={tn.listTitle} total={npcs.length} sort={{ key: "sortname", dir: "asc" }} defaultView="grid"
      columns={[
        { key: "sortname", label: tn.colName },
        { key: "town", label: tn.colPlace, hideOnPhone: true },
        { key: "sells", label: tn.colSells, align: "end", icon: "src-shop" },
        { key: "buys", label: tn.colBuys, align: "end", icon: "gold" },
        { key: "hours", label: tn.colHours, hideOnPhone: true },
      ]}
      filters={[
        { key: "town", label: tn.filterTown, options: townOpts.map(([en, o]) => ({ value: slugTown(en), label: o.label, count: o.n, icon: "src-map" })) },
        { key: "sells", label: tn.filterSells, options: catOpts(sells) },
        { key: "buys", label: tn.filterBuys, options: catOpts(buys) },
        { key: "services", label: tn.filterServices, options: (["travel", "trainer", "heal"] as const).map((k) => ({ value: k, label: SERVICE_LABEL[k], count: npcs.filter((n) => !n.spoiler && serviceKeys(n).includes(k)).length, icon: SERVICE_ICON[k] })).filter((o) => o.count) },
        { key: "hours", label: tn.filterHours, options: [{ value: "yes", label: tn.hoursTag, count: npcs.filter((n) => !n.spoiler && hasHours(n)).length, icon: "time" }] },
      ]}>
      {rows.map((n) => {
        const e = registry.require(n.ref);
        const dn = NAMES.get(n.id)!;
        const href = registry.url(n.ref, lang)!;
        const s = sells(n), b = buys(n);
        const sellN = n.spoiler ? 0 : new Set(openShifts(n).flatMap((x) => (x.sells ?? []).map((r) => r.item))).size;
        const buyN = n.spoiler ? 0 : new Set(openShifts(n).flatMap((x) => (x.buys ?? []).map((r) => r.item))).size;
        const towns = townsOf(n);
        const hours = n.spoiler ? null : openShifts(n).filter((x) => x.hours).map((x) => `${gameHour(x.hours![0])}–${gameHour(x.hours![1])}`);
        return (
          <DataRow search={[...LANGS.map((l) => e.name[l]), ...(n.spoiler ? [] : towns)].join(" ")} sort={{ sortname: dn.name, town: towns[0] ? TOWN.get(towns[0])!.label : "~", sells: sellN, buys: buyN, hours: hours?.length ? hours[0]! : "~" }}
            filters={{ town: towns.map(slugTown), sells: s, buys: b, services: n.spoiler ? [] : serviceKeys(n), hours: !n.spoiler && hasHours(n) ? ["yes"] : [] }}>
            <DataCell label={tn.colName} primary>
              <span class="name">
                <span class="render">{n.grid ? <img src={n.grid} width="128" height="128" alt="" loading="lazy" decoding="async" /> : <RenderSlot alt={dn.name} size={128} />}</span>
                <span class="small-icon"><IconSlot icon={e.icon ?? null} kind="npc" size={44} /></span>
                <span class="ntext">
                  <a href={href} title={dn.name} lang={dn.nameLang !== lang ? HREFLANG[dn.nameLang] : undefined}>{dn.name}</a>
                  {n.spoiler ? <span class="mk"><span class="kb">{(() => { const ic = icon("src-quest", 1); return <img src={ic.src} width={ic.w} height={ic.h} alt="" class="px" />; })()}{tn.questOnlyKicker}</span></span>
                    : (s.length > 0 || b.length > 0) && <span class="kinds" title={[...s, ...b].map((k) => ti.category[k as "weapon"]).join(", ")}>{[...new Set([...s, ...b])].slice(0, 5).map((k) => { const ic = icon(`cat-${k}`, 1); return <img src={ic.src} width={ic.w} height={ic.h} alt="" class="px" />; })}</span>}
                </span>
              </span>
            </DataCell>
            <DataCell label={tn.colPlace} hideOnPhone>{towns.length ? <span class="where"><span class="v v-map"></span><span class="wt">{TOWN.get(towns[0]!)!.label}</span>{towns.length > 1 && <span class="more">+{towns.length - 1}</span>}</span> : <span class="nil">—</span>}</DataCell>
            <DataCell label={tn.colSells} align="end">{sellN ? <span class="num v v-shop">{num(sellN)}</span> : <span class="nil">—</span>}</DataCell>
            <DataCell label={tn.colBuys} align="end">{buyN ? <span class="num v v-gold">{num(buyN)}</span> : <span class="nil">—</span>}</DataCell>
            <DataCell label={tn.colHours} hideOnPhone>{n.spoiler ? <span class="nil">—</span> : hours!.length ? <span class="num v v-time">{hours!.join(" · ")}</span> : <span class="v v-time always">{tn.hoursAlways}</span>}</DataCell>
          </DataRow>
        );
      })}
    </DataTable>
    <p class="count-note">{fill(t.monster.count, { n: num(npcs.length) }).replace(t.monster.listTitle.toLowerCase(), tn.listTitle)}</p>
  </div>
</PageShell>
<style is:global>
  .npcs-page.container { max-width: 1400px; }
  .npcs-page .page-head { display: flex; gap: var(--s-5); align-items: center; margin-bottom: var(--s-6); }
  .npcs-page .page-head p { margin: 8px 0 0; color: var(--text-muted); max-width: 46rem; font-size: var(--fs-lg); }
  .npcs-page .name { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .npcs-page .ntext { display: flex; flex-direction: column; justify-content: center; gap: 4px; min-width: 0; }
  .npcs-page .name a { display: block; font-weight: 700; line-height: 1.25; color: var(--heading); text-decoration: none; }
  .npcs-page .name a::after { content: ""; position: absolute; inset: 0; }
  .npcs-page tr { position: relative; }
  .npcs-page .name a:hover { color: var(--link); text-decoration: underline; }
  .npcs-page .nil { color: var(--text-faint); }
  .npcs-page .mk { display: flex; flex-wrap: wrap; gap: 4px; }
  .npcs-page .kb { display: inline-flex; align-items: center; gap: 4px; height: 22px; padding: 0 7px 0 3px; border-radius: 999px; font-size: var(--fs-xs); font-weight: 700;
    color: var(--text-muted); background: var(--surface-2); border: 1px solid var(--row-border); white-space: nowrap; }
  .npcs-page .kinds { display: inline-flex; flex-wrap: wrap; gap: 4px; }
  .npcs-page .kinds img { width: 18px; height: 18px; object-fit: contain; }
  .npcs-page .px { image-rendering: pixelated; }
  .npcs-page .where { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; font-size: var(--fs-sm); color: var(--text-muted); }
  .npcs-page .more { display: inline-flex; align-items: center; height: 20px; padding: 0 5px; border-radius: 6px; font: 700 var(--fs-xs) / 1 var(--font-num); color: var(--text-muted); border: 1px dashed var(--border-strong); }
  .npcs-page .v { display: inline-flex; align-items: center; gap: 5px; white-space: nowrap; }
  .npcs-page .v::before { content: ""; flex: none; width: 18px; height: 18px; image-rendering: pixelated; background: center / contain no-repeat; }
  .npcs-page .v-map::before { background-image: url(/ui/src-map.png); }
  .npcs-page .v-shop::before { background-image: url(/ui/src-shop.png); }
  .npcs-page .v-time::before { background-image: url(/ui/time.png); }
  .npcs-page .v-gold::before { width: 16px; height: 16px; background-image: url(/ui/gold.png); }
  .npcs-page .always { font-size: var(--fs-sm); color: var(--text-muted); }
  .npcs-page .count-note { margin-top: var(--s-4); font-size: var(--fs-sm); color: var(--text-faint); }
  .npcs-page .render { display: none; }
  .npcs-page .dt[data-view="grid"] .name { flex-direction: column; align-items: stretch; gap: 10px; width: 100%; }
  .npcs-page .dt[data-view="grid"] .ntext { min-height: 52px; justify-content: flex-start; }
  .npcs-page .dt[data-view="grid"] tbody td:last-child { display: none; }
  @media (min-width: 1024px) {
    .npcs-page.container .dt[data-view="grid"] table tbody { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .npcs-page .dt[data-view="grid"] .render { display: grid; place-items: center; height: 136px; border-radius: var(--r-m); background: var(--render-halo), var(--render-bg); }
  .npcs-page .dt[data-view="grid"] .render img { width: 128px; height: 128px; object-fit: contain; filter: var(--render-rim); }
  .npcs-page .dt[data-view="grid"] .small-icon { display: none; }
  .npcs-page .dt[data-view="grid"] .name a { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @media (min-width: 1024px) {
    .npcs-page .dt[data-view="table"] td.primary { width: 100%; max-width: 0; }
    .npcs-page .dt[data-view="table"] td:not(.primary) { white-space: nowrap; }
  }
  @media (max-width: 520px) { .npcs-page .page-head { flex-direction: column; align-items: flex-start; gap: var(--s-3); } }
</style>

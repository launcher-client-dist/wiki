---
/**
 * The item pages: one per game item (src/components/item/ItemPage.astro), and at a split name's old address the list
 * of its items (a spellbook colour, the chess pieces: src/components/item/ItemGroupPage.astro), so old links and
 * search still land somewhere.
 */
import ItemPage from "../../../components/item/ItemPage.astro";
import ItemGroupPage from "../../../components/item/ItemGroupPage.astro";
import { LANGS } from "../../../lib/i18n.ts";
import { SECTIONS } from "../../../lib/routes.ts";
import { ITEMS, siteData } from "../../../lib/site-registry.ts";

export async function getStaticPaths() {
  const { items } = await siteData();
  return [
    ...items.flatMap((item) => LANGS.map((lang) => ({ params: { lang, items: SECTIONS.item.slug[lang], slug: item.slug[lang] }, props: { id: item.id, group: false } }))),
    ...ITEMS.groups.flatMap((g) => LANGS.map((lang) => ({ params: { lang, items: SECTIONS.item.slug[lang], slug: g.slug[lang] }, props: { id: g.id, group: true } }))),
  ];
}
const { id, group } = Astro.props;
---
{group ? <ItemGroupPage id={id} /> : <ItemPage id={id} />}

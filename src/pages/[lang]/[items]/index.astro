---
import uiSizes from "../../../data/ui-icons.json";
import PageShell from "../../../components/layout/PageShell.astro";
import PixelArt from "../../../components/ui/PixelArt.astro";
import IconSlot from "../../../components/ui/IconSlot.astro";
import StatValue from "../../../components/ui/StatValue.astro";
import DataTable from "../../../components/data/DataTable.astro";
import DataRow from "../../../components/data/DataRow.astro";
import DataCell from "../../../components/data/DataCell.astro";
import { ui, fill } from "../../../i18n/index.ts";
import { HREFLANG, LANGS, type Lang } from "../../../lib/i18n.ts";
import { homePath, SECTIONS, sectionAlternates, sectionPath } from "../../../lib/routes.ts";
import { ITEMS, siteData } from "../../../lib/site-registry.ts";
import { CATEGORIES, CLASS_KEYS, SOURCE_KINDS, STAT_KEYS, goldPerOz, primaryVersion, sourceKinds, statLabel, type StatKey } from "../../../lib/items/data.ts";
import { num, oz } from "../../../lib/items/view.ts";
import { displayName } from "../../../lib/names.ts";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang, items: SECTIONS.item.slug[lang] } }));
}
const lang = Astro.params.lang as Lang;
const t = ui(lang);
const ti = t.item;
const { registry, items } = await siteData();
/** Each item's in-game name (the title, English today) and its translation (the second line): src/lib/names.ts. */
const NAMES = new Map(items.map((i) => [i.id, displayName(i.name, "item", lang)]));
const rows = [...items].sort((a, b) => NAMES.get(a.id)!.name.localeCompare(NAMES.get(b.id)!.name, lang));
const SLOT_ORDER = ["head", "neck", "body", "legs", "feet", "hands", "ring", "back", "ammo"];
const UI = uiSizes as Record<string, number[]>;
const SOURCE_ICON: Record<string, string> = { drop: "src-drop", shop: "src-shop", quest: "src-quest", craft: "src-craft", map: "src-map", conjure: "src-conjure", leftover: "src-leftover" };
const count = <T extends string>(key: T, fn: (i: (typeof items)[number]) => T[]) => items.filter((i) => fn(i).includes(key)).length;
/** The spellbook colours (the Evil books' game type is "book", not "spellbook": the group says it). */
const BOOK_GROUPS = new Set(ITEMS.groups.filter((g) => g.kind === "spellbook").map((g) => g.id));
const CLASSED: StatKey[] = ["armor", "defense", "attackSpeed", "health", "mana", "hpRegen", "mpRegen"];
---
<PageShell lang={lang} title={ti.listTitle} description={ti.listDescription} alternates={sectionAlternates("item")} current="item"
  searchable={{ kind: "item" }}
  crumbs={[{ label: t.home, href: homePath(lang) }, { label: ti.listTitle, href: sectionPath("item", lang) }]}>
  <div class="container items-page">
    <header class="page-head">
      <PixelArt kind="item" size={64} />
      <div>
        <h1>{ti.listTitle}</h1>
        <p>{ti.listIntro}</p>
      </div>
    </header>
    <DataTable id="items" lang={lang} caption={ti.listTitle} total={items.length} sort={{ key: "sortname", dir: "asc" }}
      columns={[
        { key: "sortname", label: ti.colItem },
        { key: "type", label: ti.colType, hideOnPhone: true },
        { key: "damage", label: statLabel("damage")[lang], align: "end", icon: "stat-damage" },
        { key: "armor", label: statLabel("armor")[lang], align: "end", icon: "stat-armor" },
        { key: "defense", label: statLabel("defense")[lang], align: "end", icon: "stat-defense" },
        { key: "magic", label: statLabel("magic")[lang], align: "end", hideOnPhone: true, icon: "stat-magic" },
        { key: "weight", label: ti.colWeight, align: "end", hideOnPhone: true, icon: "stat-weight" },
        { key: "value", label: ti.colValue, align: "end", icon: "gold" },
        { key: "goldoz", label: ti.colGoldOz, align: "end", hideOnPhone: true, icon: "gold" },
        { key: "where", label: ti.colWhere, sortable: false },
      ]}
      filters={[
        { key: "category", label: ti.filterCategory, options: CATEGORIES.filter((c) => items.some((i) => i.category === c)).map((c) => ({ value: c, label: ti.category[c], count: items.filter((i) => i.category === c).length, icon: `cat-${c}` })) },
        { key: "slot", label: ti.filterSlot, options: SLOT_ORDER.filter((s) => items.some((i) => i.slots.includes(s))).map((s) => ({ value: s, label: ti.slot[s as keyof typeof ti.slot], count: count(s, (i) => i.slots), icon: `slot-${s}` })) },
        // a spellbook's colour (its old page, now the list of the colour's books): one chip per colour, with its face
        { key: "book", label: ti.filterBook, options: ITEMS.groups.filter((g) => g.kind === "spellbook").map((g) => {
          const e = registry.require(`item:${g.id}`);
          return e.icon ? { value: g.id, label: g.name[lang], count: g.members.length, img: e.icon } : { value: g.id, label: g.name[lang], count: g.members.length, icon: "cat-spellbook" };
        }) },
        { key: "where", label: ti.filterWhere, options: SOURCE_KINDS.map((k) => ({ value: k, label: ti.source[k], count: count(k, sourceKinds), icon: SOURCE_ICON[k] })).filter((o) => o.count) },
      ]}
      variants={[{ key: "base", label: ti.classBase, icon: "class" }, ...CLASS_KEYS.map((k) => ({ key: k, label: ti.classes[k], icon: `class-${k}` }))]} variantLabel={ti.filterClass} variantNote={ti.traitsNote}
      ranges={STAT_KEYS.map((k) => ({ key: k, label: statLabel(k)[lang] }))} rangeLabel={ti.filterStat}>
      {rows.map((item) => {
        const v = primaryVersion(item);
        const st = v.stats;
        const sort: Record<string, string | number> = {
          sortname: NAMES.get(item.id)!.name, type: item.subtype[lang], weight: v.weight,
          value: item.value.npcPays ?? 0, goldoz: goldPerOz(item) ?? 0,
        };
        // only what an item has: a missing sort value reads as 0 (keeps 436 rows light)
        for (const k of STAT_KEYS) {
          if (!st[k]) continue;
          sort[k] = st[k]!;
          if (CLASSED.includes(k) && v.classes && CLASS_KEYS.some((c) => (v.classes?.[c]?.[k] ?? st[k]) !== st[k])) {
            sort[`${k}__base`] = st[k]!;
            for (const c of CLASS_KEYS) sort[`${k}__${c}`] = v.classes?.[c]?.[k] ?? st[k]!;
          }
        }
        const cls = (k: StatKey) => (v.classes && CLASS_KEYS.some((c) => (v.classes?.[c]?.[k] ?? st[k]) !== st[k])
          ? Object.fromEntries(CLASS_KEYS.map((c) => [c, v.classes?.[c]?.[k] ?? st[k]])) : undefined);
        const href = registry.url(`item:${item.id}`, lang)!;
        const icon = v.icon && v.iconSize ? { src: v.icon, width: v.iconSize[0], height: v.iconSize[1], pixel: true } : null;
        return (
          <DataRow search={[...LANGS.map((l) => item.name[l]), ...LANGS.map((l) => item.subtype[l])].join(" ")} sort={sort}
            filters={{ category: item.category, slot: item.slots, where: sourceKinds(item), book: item.group && BOOK_GROUPS.has(item.group) ? item.group : [] }}>
            <DataCell label={ti.colItem} primary>
              <span class="name">
                <IconSlot icon={icon} kind="item" size={44} />
                {(() => {
                  const dn = NAMES.get(item.id)!;
                  return <span class="ntext"><a href={href} title={dn.name} lang={dn.nameLang !== lang ? HREFLANG[dn.nameLang] : undefined}>{dn.name}</a>{dn.aid && <span class="alt" title={dn.aid} lang={dn.aidLang && dn.aidLang !== lang ? HREFLANG[dn.aidLang] : undefined}>{dn.aid}</span>}</span>;
                })()}
              </span>
            </DataCell>
            <DataCell label={ti.colType} hideOnPhone><span class="type">{item.subtype[lang]}</span></DataCell>
            <DataCell label={statLabel("damage")[lang]} align="end">{st.damage ? <StatValue value={st.damage} /> : <span class="nil">—</span>}</DataCell>
            <DataCell label={statLabel("armor")[lang]} align="end">{st.armor ? <StatValue value={st.armor} variants={cls("armor")} /> : <span class="nil">—</span>}</DataCell>
            <DataCell label={statLabel("defense")[lang]} align="end">{st.defense ? <StatValue value={st.defense} variants={cls("defense")} /> : <span class="nil">—</span>}</DataCell>
            <DataCell label={statLabel("magic")[lang]} align="end" hideOnPhone>{st.magic ? <StatValue value={st.magic} /> : <span class="nil">—</span>}</DataCell>
            <DataCell label={ti.colWeight} align="end" hideOnPhone><span class="num v v-oz">{oz(v.weight, lang)}</span></DataCell>
            <DataCell label={ti.colValue} align="end">{item.value.npcPays ? <span class="num v v-gold">{num(item.value.npcPays, lang)}</span> : <span class="nil">—</span>}</DataCell>
            <DataCell label={ti.colGoldOz} align="end" hideOnPhone>{goldPerOz(item) ? <span class="num v v-gold">{num(goldPerOz(item)!, lang)}</span> : <span class="nil">—</span>}</DataCell>
            <DataCell label={ti.colWhere}><span class:list={["where", { many: sourceKinds(item).length > 4 }]}>{sourceKinds(item).map((k) => <span class="srcb" title={ti.source[k]}><img src={`/ui/${SOURCE_ICON[k]}.png`} width={UI[SOURCE_ICON[k]!]![0]! * 2} height={UI[SOURCE_ICON[k]!]![1]! * 2} alt={ti.source[k]} class="px" /></span>)}{sourceKinds(item).length > 4 && <span class="more" aria-hidden="true" title={sourceKinds(item).slice(3).map((k) => ti.source[k]).join(", ")}>+{sourceKinds(item).length - 3}</span>}</span></DataCell>
          </DataRow>
        );
      })}
    </DataTable>
    <p class="count-note">{fill(ti.count, { n: num(items.length, lang) })}</p>
  </div>
</PageShell>
<style is:global>
  /* global but under .items-page: no per-element scope attribute on 436 rows */
  .items-page .page-head { display: flex; gap: var(--s-5); align-items: center; margin-bottom: var(--s-6); }
  .items-page .page-head p { margin: 8px 0 0; color: var(--text-muted); max-width: 46rem; font-size: var(--fs-lg); }
  /* the name cell: the icon and the two names on one centre line; each name one line (a long one ends in "…", whole in
     its title), so every row of the table has the same height */
  .items-page .name { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .items-page .ntext { display: flex; flex-direction: column; justify-content: center; gap: 2px; min-width: 0; }
  .items-page .name a, .items-page .alt { display: block; }
  .items-page .name a { font-weight: 700; line-height: 1.25; color: var(--heading); text-decoration: none; }
  .items-page .name a:hover { color: var(--link); text-decoration: underline; }
  .items-page .alt { font-size: var(--fs-xs); line-height: 1.25; color: var(--text-faint); }
  .items-page .type { display: block; max-width: 11.5rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: var(--fs-sm); color: var(--text-muted); }
  .items-page .nil { color: var(--text-faint); }
  /* where it comes from: one line, four badges at most; five show three and "+2" (the rest stay for screen readers) */
  .items-page .where { display: inline-flex; flex-wrap: nowrap; gap: 4px; align-items: center; }
  .items-page .where.many .srcb:nth-child(n+4) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .items-page .more { display: inline-flex; align-items: center; justify-content: center; height: 26px; min-width: 26px; padding: 0 4px; border-radius: 6px;
    font: 700 var(--fs-xs) / 1 var(--font-num); color: var(--text-muted); border: 1px dashed var(--border-strong); }
  /* the table view: the name column takes the room left, every other column is as wide as its header or its values */
  @media (min-width: 1024px) {
    .items-page .dt[data-view="table"] td.primary { width: 100%; max-width: 0; }
    .items-page .dt[data-view="table"] td:not(.primary) { white-space: nowrap; }
    .items-page .dt[data-view="table"] .name a, .items-page .dt[data-view="table"] .alt { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    /* the header carries the column's icon: a cell repeats it only in the grid cards (they have no header) */
    .items-page .dt[data-view="table"] .v::before { display: none; }
  }
  .items-page .srcb { display: inline-flex; align-items: center; justify-content: center; gap: 4px; height: 26px; min-width: 26px; padding: 0 3px; border-radius: 6px; font-size: var(--fs-xs);
    font-weight: 700; color: var(--text-muted); background: var(--surface-2); border: 1px solid var(--row-border); white-space: nowrap; }
  .items-page .srcb .px { image-rendering: pixelated; }
  /* the money and weight cells: the game's coin / weight icon before the number (CSS, so 440 rows carry no extra tags) */
  .items-page .v { display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
  .items-page .v::before { content: ""; flex: none; image-rendering: pixelated; background: center / contain no-repeat; }
  .items-page .v-gold::before { width: 16px; height: 16px; background-image: url(/ui/gold.png); }
  .items-page .v-oz::before { width: 18px; height: 18px; background-image: url(/ui/stat-weight.png); }
  .items-page .count-note { margin-top: var(--s-4); font-size: var(--fs-sm); color: var(--text-faint); }
  /* narrow desktops (1024-1199): the type column goes (its filter chips stay), so every column fits without scrolling */
  /* the list is the one wide page: its own measure, so nine one-line headers and the names fit */
  .items-page.container { max-width: 1400px; }
  /* narrower desktops: the type column goes below 1360, gold per oz below 1200 (their filters and sort stay, the grid
     view and the item pages keep them), so the names stay readable and every header stays on one line */
  @media (min-width: 1024px) and (max-width: 1359px) { .items-page th[data-col="type"], .items-page tbody td:nth-child(2) { display: none; } }
  @media (min-width: 1024px) and (max-width: 1199px) { .items-page th[data-col="goldoz"], .items-page tbody td:nth-child(9) { display: none; } }
  @media (max-width: 520px) { .items-page .page-head { flex-direction: column; align-items: flex-start; gap: var(--s-3); } }
</style>

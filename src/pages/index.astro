---
/**
 * "/": sends the reader to the first of their browser's languages the wiki has (by its two-letter code), else the
 * default language's home, with plain links as the fallback. Not indexed: x-default and the canonical point at the
 * default language's home.
 */
import "../styles/global.css";
import { ui } from "../i18n/index.ts";
import { DEFAULT_LANG, HREFLANG, LANGS } from "../lib/i18n.ts";
import { absoluteUrl, homePath } from "../lib/routes.ts";
import PixelArt from "../components/ui/PixelArt.astro";
const home = ui(DEFAULT_LANG);
---
<!doctype html>
<html lang={HREFLANG[DEFAULT_LANG]} data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline define:vars={{ langs: LANGS, fallback: DEFAULT_LANG }}>
    var wanted = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || fallback]);
    var pick = fallback;
    search: for (var i = 0; i < wanted.length; i++) {
      var code = String(wanted[i]).toLowerCase().slice(0, 2);
      for (var j = 0; j < langs.length; j++) if (langs[j] === code) { pick = code; break search; }
    }
    location.replace("/" + pick + "/" + location.search + location.hash);
  </script>
  <title>{home.siteName}</title>
  <meta name="description" content={home.siteDescription} />
  <meta name="robots" content="noindex, follow" />
  <link rel="canonical" href={absoluteUrl(homePath(DEFAULT_LANG))} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <main class="pick">
    <PixelArt logo size={56} />
    <h1>{home.siteName}</h1>
    <ul>
      {LANGS.map((l) => <li><a href={homePath(l)} hreflang={HREFLANG[l]} lang={HREFLANG[l]}>{ui(l).langName}</a></li>)}
    </ul>
  </main>
</body>
</html>
<style>
  .pick { min-height: 100vh; display: grid; place-content: center; justify-items: center; gap: var(--s-4); text-align: center; padding: var(--gutter); }
  ul { list-style: none; display: flex; gap: var(--s-3); padding: 0; margin: 0; }
  a { display: inline-block; padding: 12px 20px; border: var(--bw) solid var(--hard); border-radius: var(--r-m); background: var(--surface); box-shadow: var(--shadow-1); font-weight: 700; text-decoration: none; color: var(--heading); }
</style>

---
/**
 * "/": sends the reader to /pt/ or /en/ by their browser's language (a tiny inline script), with plain links as the
 * fallback. Not indexed: x-default and the canonical point at /pt/.
 */
import "../styles/global.css";
import { ui } from "../i18n/index.ts";
import { HREFLANG, LANGS } from "../lib/i18n.ts";
import { absoluteUrl, homePath } from "../lib/routes.ts";
import PixelArt from "../components/ui/PixelArt.astro";
const pt = ui("pt");
---
<!doctype html>
<html lang="pt-BR" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    (function () {
      var langs = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || "pt"]);
      var en = false;
      for (var i = 0; i < langs.length; i++) {
        var l = String(langs[i]).toLowerCase();
        if (l.indexOf("pt") === 0) break;
        if (l.indexOf("en") === 0) { en = true; break; }
      }
      location.replace((en ? "/en/" : "/pt/") + location.search + location.hash);
    })();
  </script>
  <title>{pt.siteName}</title>
  <meta name="description" content={pt.siteDescription} />
  <meta name="robots" content="noindex, follow" />
  <link rel="canonical" href={absoluteUrl("/pt/")} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <main class="pick">
    <PixelArt logo size={56} />
    <h1>{pt.siteName}</h1>
    <ul>
      {LANGS.map((l) => <li><a href={homePath(l)} hreflang={HREFLANG[l]} lang={HREFLANG[l]}>{ui(l).langName}</a></li>)}
    </ul>
  </main>
</body>
</html>
<style>
  .pick { min-height: 100vh; display: grid; place-content: center; justify-items: center; gap: var(--s-4); text-align: center; padding: var(--gutter); }
  ul { list-style: none; display: flex; gap: var(--s-3); padding: 0; margin: 0; }
  a { display: inline-block; padding: 12px 20px; border: var(--bw) solid var(--hard); border-radius: var(--r-m); background: var(--surface); box-shadow: var(--shadow-1); font-weight: 700; text-decoration: none; color: var(--heading); }
</style>

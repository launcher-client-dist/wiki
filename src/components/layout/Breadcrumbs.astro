---
/** The trail to the current page (the last item has no link). PageShell adds the matching BreadcrumbList JSON-LD. */
export interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
  label: string;
}
const { items, label } = Astro.props;
---
<nav class="crumbs" aria-label={label}>
  <ol>
    {items.map((c, i) => (
      <li>{i < items.length - 1 && c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs { margin: var(--s-5) 0 var(--s-4); font-size: var(--fs-sm); color: var(--text-muted); }
  ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  li + li::before { content: "▸"; margin-right: 6px; color: var(--text-faint); font-size: 0.75em; }
  a { color: var(--text-muted); text-decoration: none; }
  a:hover { color: var(--link); text-decoration: underline; }
  [aria-current] { color: var(--heading); font-weight: 600; }
</style>

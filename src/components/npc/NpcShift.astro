---
/**
 * One shift of an NPC (an actor the game places under its name): its place and map link, its hours in game time, every
 * real hour, and the next change in the reader's clock ("agora: está lá até HH:MM" / "volta às HH:MM"); with several
 * shifts, the shift's own shop, services and Conversa too. Its anchor (#turno-N) is where the map's marker opens.
 */
import GameIcon from "../ui/GameIcon.astro";
import MapLink from "../ui/MapLink.astro";
import Spoiler from "../ui/Spoiler.astro";
import TipTag from "../ui/TipTag.astro";
import NpcTrade from "./NpcTrade.astro";
import NpcServices from "./NpcServices.astro";
import NpcTalk from "./NpcTalk.astro";
import { ui, fill } from "../../i18n/index.ts";
import { DEFAULT_LANG, isLang, type Lang } from "../../lib/i18n.ts";
import { gameHour, placeLine, realOffset } from "../../lib/monsters/data.ts";
import { windowSeconds } from "../../lib/monsters/window.ts";
import { shiftAnchor, type NpcShift } from "../../lib/npcs/data.ts";
interface Props {
  sh: NpcShift;
  i: number;
  /** The character has several shifts: number them and show each one's own shop. */
  many: boolean;
  entity: string;
}
const { sh, i, many, entity } = Astro.props;
const lang: Lang = isLang(Astro.params.lang) ? Astro.params.lang : DEFAULT_LANG;
const t = ui(lang);
const tn = t.npc;
const ti = t.item;
const win = sh.hours ? windowSeconds(sh.hours) : null;
const id = shiftAnchor(i);
const inner = many;
---
<article class="shift" id={id} {...(win ? { "data-win-start": String(win.start), "data-win-end": String(win.end) } : {})}>
  <header class="shead">
    {many && <h3 class="sname">{fill(tn.shiftN, { n: i + 1 })}</h3>}
    <p class="splace" data-flow><span class="wicon"><GameIcon name="src-map" fit={22} /></span><span>{placeLine(sh.place, lang, ti.near, ti.underground)}</span><MapLink variant="inline" href={sh.link} entity={entity} label={ti.mapLink} /></p>
  </header>
  {sh.hours ? (
    <div class="times">
      <span class="tgame"><span class="wicon"><GameIcon name="time" fit={26} /></span><span><small>{tn.outGame}</small><b class="num">{gameHour(sh.hours[0])}–{gameHour(sh.hours[1])}</b></span></span>
      <span class="treal"><small>{tn.outReal}</small><span>{fill(tn.outRealText, { a: realOffset(sh.hours[0]).slice(0, 2), b: realOffset(sh.hours[1]).slice(0, 2) })}</span></span>
      <p class="tnext" data-win-next data-t-now={tn.nowThere} data-t-back={tn.backAt} data-t-clock={tn.clock} aria-live="polite"></p>
    </div>
  ) : (
    <p class="always"><GameIcon name="time" scale={1} />{tn.always}</p>
  )}
  {sh.spoiler && sh.afterQuests.length === 0 && <p class="gate"><TipTag icon="src-quest" tip={tn.afterQuestTip}>{tn.afterQuest}</TipTag></p>}
  {inner && (sh.sells?.length || sh.buys?.length || sh.services) && (
    sh.spoiler ? (
      <Spoiler title={tn.afterQuest}>
        <NpcTrade sh={sh} nested id={id} />
        <NpcServices sh={sh} nested id={id} />
      </Spoiler>
    ) : (
      <>
        <NpcTrade sh={sh} nested id={id} />
        <NpcServices sh={sh} nested id={id} />
      </>
    )
  )}
  {inner && sh.conversation?.length ? <NpcTalk lines={sh.conversation} nested intro={tn.talkIntroShift} id={id} /> : null}
</article>
<style>
  .shift { display: grid; gap: 12px; padding: 16px 18px; background: var(--card-bg); border: var(--bw) solid var(--border); border-left: 4px solid var(--sky); border-radius: var(--r-l); scroll-margin-top: calc(var(--header-h) + 16px); }
  .shift:target { border-left-color: var(--sun); box-shadow: 0 0 0 2px color-mix(in srgb, var(--sun) 40%, transparent); }
  .shead { display: grid; gap: 6px; }
  .sname { margin: 0; font-size: var(--fs-md); }
  .splace { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin: 0; color: var(--text); }
  .times { display: grid; gap: 10px; grid-template-columns: minmax(0, 1fr); }
  @container main (min-width: 520px) { .times { grid-template-columns: auto minmax(0, 1fr); align-items: center; column-gap: 28px; } }
  .tgame { display: flex; align-items: center; gap: 12px; }
  .tgame > span:last-child, .treal { display: grid; gap: 2px; }
  .times small { font-size: var(--fs-xs); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
  .tgame b { font-size: 1.375rem; color: var(--heading); }
  .wicon { display: inline-grid; place-items: center; width: 36px; height: 36px; flex: none; border-radius: 9px; background: var(--well); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06); }
  .tnext { grid-column: 1 / -1; margin: 0; font-weight: 700; color: var(--accent-text); }
  .tnext:empty { display: none; }
  .always { display: flex; align-items: center; gap: 8px; margin: 0; color: var(--text-muted); }
  .gate { margin: 0; }
  .num { font-family: var(--font-num); }
</style>

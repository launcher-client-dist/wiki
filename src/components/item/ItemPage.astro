---
import PageShell from "../../components/layout/PageShell.astro";
import Banner from "../../components/ui/Banner.astro";
import IconSlot from "../../components/ui/IconSlot.astro";
import InfoBox from "../../components/ui/InfoBox.astro";
import StatValue from "../../components/ui/StatValue.astro";
import VariantSwitch from "../../components/ui/VariantSwitch.astro";
import ListPanel from "../../components/ui/ListPanel.astro";
import ListRow from "../../components/ui/ListRow.astro";
import TierBadge from "../../components/ui/TierBadge.astro";
import Spoiler from "../../components/ui/Spoiler.astro";
import Callout from "../../components/ui/Callout.astro";
import MapLink from "../../components/ui/MapLink.astro";
import Card from "../../components/ui/Card.astro";
import EntityLink from "../../components/entity/EntityLink.astro";
import GameIcon from "../../components/ui/GameIcon.astro";
import StatChips from "../../components/ui/StatChips.astro";
import TipTag from "../../components/ui/TipTag.astro";
import Value from "../../components/ui/Value.astro";
import { statRank } from "../../lib/items/rank.ts";
import Ingredient from "../../components/entity/Ingredient.astro";
import { ui, fill } from "../../i18n/index.ts";
import { HREFLANG, LANGS, type Lang } from "../../lib/i18n.ts";
import { absoluteUrl, homePath, SECTIONS, sectionPath } from "../../lib/routes.ts";
import { ITEMS, STUB_BY_REF, siteData } from "../../lib/site-registry.ts";
import { appearsIn } from "../../lib/entities/appears.ts";
import { CLASS_KEYS, STAT_KEYS, goldPerOz, primaryVersion, signed, statLabel, textLang, type Fallback, type Place, type Recipe, type StatKey } from "../../lib/items/data.ts";
import { metaDescription, oneInText, oz, similarItems } from "../../lib/items/view.ts";
import { allNames, displayName, nameWithAid } from "../../lib/names.ts";

/** One item's page (src/pages/[lang]/[items]/[slug].astro picks it, or a group's list page). */
interface Props {
  id: string;
}
const lang = Astro.params.lang as Lang;
const t = ui(lang);
const ti = t.item;
const { registry, items } = await siteData();
const item = items.find((i) => i.id === Astro.props.id)!;
const ref = `item:${item.id}`;
/** An item that changes when equipped leads with its equipped state (its stats live there: the page says so). */
const states = item.states ? { stored: item.versions.find((x) => x.type === item.states!.stored)!, equipped: item.versions.find((x) => x.type === item.states!.equipped)! } : null;
const v = states?.equipped ?? primaryVersion(item);
/** A pair whose equipped state has no stats (the rings, the amulet): its effect is in its text, so the page says "effect". */
const statesIntro = states && Object.values(states.equipped.stats).some(Boolean) ? ti.statesIntro : ti.statesIntroEffect;
const sameText = !!states && states.stored.text.en === states.equipped.text.en;
const duration = (s: number) => (s >= 120 && s % 60 === 0 ? fill(ti.minutes, { n: s / 60 }) : `${s} s`);
const vIcon = (x: { icon?: string; iconSize?: [number, number] }) => (x.icon && x.iconSize ? { src: x.icon, width: x.iconSize[0], height: x.iconSize[1], pixel: true } : null);
/** The title is the in-game name (English today); the page language's translation is the subtitle (src/lib/names.ts). */
const dn = displayName(item.name, "item", lang);
/** A text standing in as English where the game has no translation: its lang attribute (undefined when it is in `lang`). */
const fbLang = (t: Fallback) => (textLang(t, lang) === lang ? undefined : HREFLANG[textLang(t, lang)]);
const alternates = Object.fromEntries(LANGS.map((l) => [l, registry.url(ref, l)!])) as Record<Lang, string>;
const icon = v.icon && v.iconSize ? { src: v.icon, width: v.iconSize[0], height: v.iconSize[1], pixel: true } : null;
const statKeys = STAT_KEYS.filter((k) => v.stats[k]);
const classVariants = (k: StatKey, src: { classes?: Partial<Record<string, Partial<Record<StatKey, number>>>>; stats: Partial<Record<StatKey, number>> }) =>
  Object.fromEntries(CLASS_KEYS.map((c) => [c, src.classes?.[c]?.[k] ?? src.stats[k]]));
const hasClasses = !!v.classes && statKeys.some((k) => CLASS_KEYS.some((c) => (v.classes?.[c]?.[k] ?? v.stats[k]) !== v.stats[k]));
const qualities = v.qualities && (statKeys.length || v.lifetime) ? v.qualities : null;
const qualityKeys = qualities ? STAT_KEYS.filter((k) => qualities.some((q) => q.stats[k])) : [];
const src = item.sources;
const shopsOpen = src.shops.filter((s) => !s.spoiler);
const shopsGated = src.shops.filter((s) => s.spoiler);
const buyersOpen = src.buyers.filter((s) => !s.spoiler);
const buyersGated = src.buyers.filter((s) => s.spoiler);
const anyQualityDrop = src.drops.some((d) => d.quality);
const runesForThis = items.filter((o) => o.rune?.fitsItems.includes(item.id));
const spells = [...new Set(item.versions.map((x) => x.spell).filter(Boolean))] as string[];
const ingotSteps = ITEMS.forging.filter((f) => f.ingot === item.id);
const similar = similarItems(items, item);
/** One item's sprite per subtype (the first by id): a rune's "fits" chips show what each type looks like. */
const SUB_ICON = new Map<string, { src: string; width: number; height: number; pixel: true }>();
for (const o of [...items].sort((a, b) => a.id.localeCompare(b.id))) {
  const ov = primaryVersion(o);
  if (!SUB_ICON.has(o.subtype.key) && ov.icon && ov.iconSize) SUB_ICON.set(o.subtype.key, { src: ov.icon, width: ov.iconSize[0], height: ov.iconSize[1], pixel: true });
}
/** A long list of places (some items lie in 300 spots): the first ones shown, the rest one click away. */
const MAP_SHOWN = 12;
/** A potion's or a food's effect is told once: in the stats box when the item has no stats, else in "Efeito". */
const effectInBox = statKeys.length === 0 && !!(v.potion || v.food);
const appears = appearsIn(registry, ref, ["droppedBy", "soldBy", "boughtBy", "rewardOf", "requiredBy", "usedIn", "conjuredBy", "taughtBy", "leftBy"]);
const description = metaDescription(item, lang);
const placeText = (p: Place) => `${p.town[lang]}${p.near ? ` · ${ti.near} ${p.near[lang]}` : ""}${p.underground ? ` · ${ti.underground}` : ""}`;
const versionLabel = (i: number) => fill(ti.versionN, { n: i + 1 });
const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "Thing",
  name: dn.name,
  alternateName: allNames(item.name).filter((n) => n !== dn.name),
  description,
  url: absoluteUrl(alternates[lang]),
  inLanguage: HREFLANG[lang],
  ...(icon ? { image: absoluteUrl(icon.src) } : {}),
  additionalProperty: statKeys.map((k) => ({ "@type": "PropertyValue", name: statLabel(k)[lang], value: v.stats[k] })),
}];
---
<PageShell lang={lang} title={nameWithAid(dn)} description={description} alternates={alternates} current="item"
  searchable={{ kind: "item", image: icon?.src }} jsonLd={jsonLd} ogImage={`/og/items/${item.slug.en}.png`}
  crumbs={[{ label: t.home, href: homePath(lang) }, { label: ti.listTitle, href: sectionPath("item", lang) }, { label: dn.name }]}>
  <div class="container" id="item-page">
    <div class="layout">
      <div class="hero-area">
        <Banner>
          <div slot="media" class="hero-icon"><IconSlot icon={icon} kind="item" size={160} /></div>
          <p class="kicker" data-pagefind-ignore>{ti.category[item.category]}</p>
          <h1 lang={dn.nameLang !== lang ? HREFLANG[dn.nameLang] : undefined}>{dn.name}</h1>
          {dn.aid && <p class="alt" lang={dn.aidLang && dn.aidLang !== lang ? HREFLANG[dn.aidLang] : undefined} data-pagefind-meta="alt">{dn.aid}</p>}
          {v.text[lang] && <blockquote class="game-text" lang={fbLang(v.text)}>{v.text[lang]}</blockquote>}
          <div class="tags" slot="foot" data-pagefind-ignore>
            <TipTag icon={`cat-${item.category}`} tip={ti.tipType}>{fill(ti.tagType, { v: item.subtype[lang] })}</TipTag>
            {item.slots.map((s) => {
              const word = ti.slot[s as keyof typeof ti.slot];
              return <TipTag icon={`slot-${s}`} iconScale={1} tip={fill(ti.tipSlot, { v: word })}>{fill(ti.tagSlot, { v: word })}</TipTag>;
            })}
            {item.armourClass && <TipTag icon="stat-armor" tip={item.armourClass === "heavy" ? ti.tipHeavy : ti.tipLight}>{item.armourClass === "heavy" ? ti.heavy : ti.light}</TipTag>}
            {item.twoHanded && <TipTag icon="stat-damage" tip={ti.tipLarge}>{ti.twoHanded}</TipTag>}
            {item.versions.length > 1 && !states && <TipTag tone="sun" tip={fill(ti.tipVersions, { n: item.versions.length })}>{fill(ti.versionsTag, { n: item.versions.length })}</TipTag>}
          </div>
        </Banner>
      </div>
      <div class="main">
        {states && (
          <section class="block" aria-labelledby="h-states" data-section="states">
            <h2 id="h-states">{ti.statesTitle}</h2>
            <p class="muted">{statesIntro}</p>
            <div class="states">
              <div class="state">
                <p class="slabel">{ti.stored}</p>
                <div class="shead"><IconSlot icon={vIcon(states.stored)} kind="item" size={56} />{states.stored.text[lang] && !sameText && <p class="vt" lang={fbLang(states.stored.text)}>{states.stored.text[lang]}</p>}</div>
                {Object.values(states.stored.stats).some(Boolean) ? <div class="vs"><StatChips stats={states.stored.stats} lang={lang} /></div> : <p class="nostat"><GameIcon name="minus" scale={1} />{statesIntro === ti.statesIntro ? ti.storedNoStats : ti.storedNoEffect}</p>}
              </div>
              <span class="sarrow" aria-hidden="true">➜</span>
              <div class="state on">
                <p class="slabel">{ti.equipped}</p>
                <div class="shead"><IconSlot icon={vIcon(states.equipped)} kind="item" size={56} />{states.equipped.text[lang] && <p class="vt" lang={fbLang(states.equipped.text)}>{states.equipped.text[lang]}</p>}</div>
                {Object.values(states.equipped.stats).some(Boolean) && <div class="vs"><StatChips stats={states.equipped.stats} lang={lang} /></div>}
                <p class="sfacts">
                  {states.equipped.lifetime && <span class="sval" title={ti.lastsTip}><GameIcon name="time" scale={1} />{fill(ti.lasts, { t: duration(states.equipped.lifetime) })}</span>}
                  {states.equipped.light && <span class="sval"><GameIcon name="src-conjure" scale={1} />{ti.lightsUp}</span>}
                </p>
              </div>
            </div>
            <ul class="srules">
              <li><span class="eicon"><GameIcon name="time" scale={2} /></span><span>{ti.runsOut}</span></li>
              <li><span class="eicon"><GameIcon name="slot-hands" scale={1} /></span><span>{ti.unequip}</span></li>
            </ul>
          </section>
        )}

        {item.versions.length > 1 && !states && (
          <section class="block" aria-labelledby="h-versions" data-pagefind-ignore>
            <h2 id="h-versions">{ti.versionsTitle}</h2>
            <p class="muted">{fill(ti.versionsIntro, { n: item.versions.length })}</p>
            <div class="versions">
              {item.versions.map((x, i) => (
                <div class="version">
                  <IconSlot icon={x.icon && x.iconSize ? { src: x.icon, width: x.iconSize[0], height: x.iconSize[1], pixel: true } : null} kind="item" size={48} />
                  <div>
                    <strong>{versionLabel(i)}{x.type === v.type ? " ★" : ""}</strong>
                    {x.text[lang] && <p class="vt" lang={fbLang(x.text)}>{x.text[lang]}</p>}
                    <div class="vs"><StatChips stats={x.stats} lang={lang} /></div>
                    {x.becomesWhenEquipped && <p class="muted small">{ti.versionEquip}</p>}
                    {x.spell && <p class="small">{ti.spellTitle}: <EntityLink to={x.spell} /></p>}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        {((!effectInBox && (v.food || v.potion)) || (v.lifetime && !states) || v.drinkSeconds || v.resistSeconds) && (
          <section class="block" aria-labelledby="h-effect">
            <h2 id="h-effect">{ti.effectTitle}</h2>
            <div class="effects">
              {v.potion && !effectInBox && <p class="effect"><span class="eicon"><GameIcon name={v.potion.stat === "health" ? "stat-health" : "stat-mana"} scale={3} /></span> {fill(ti.potion, { min: v.potion.min, max: v.potion.max, stat: v.potion.stat === "health" ? ti.potionHealth : ti.potionMana, s: v.potion.seconds })}</p>}
              {v.food && !effectInBox && (
                <div class="effect">
                  <p class="erow"><span class="eicon"><GameIcon name="food" scale={3} /></span> {fill(ti.food, { n: v.food.seconds })}</p>
                  {Object.keys(v.food.buff).length > 0 && <p class="buffs">{ti.foodBuff}: {(Object.entries(v.food.buff) as [StatKey, number][]).map(([k, n]) => <span class="buff"><GameIcon name={`stat-${k}`} />{statLabel(k)[lang]} <StatValue value={n} /></span>)}</p>}
                </div>
              )}
              {v.drinkSeconds && <p class="effect"><span class="eicon"><GameIcon name="time" scale={3} /></span> {fill(ti.drink, { n: v.drinkSeconds })}</p>}
              {v.resistSeconds && <p class="effect"><span class="eicon"><GameIcon name="stat-defense" scale={3} /></span> {fill(ti.resist, { n: v.resistSeconds })}</p>}
              {v.lifetime && !states && <p class="effect"><span class="eicon"><GameIcon name="time" scale={3} /></span> {fill(ti.lifetime, { n: v.lifetime })}</p>}
            </div>
          </section>
        )}

        {qualities && (
          <section class="block" aria-labelledby="h-qualities">
            <h2 id="h-qualities">{ti.qualities}</h2>
            <p class="muted">{ti.qualitiesIntro}</p>
            <ol class="qcards" data-section="quality-cards" data-pagefind-ignore="all">
              {qualities.map((q) => {
                const q0 = qualities[0]!;
                const qname = ti.quality[`q${q.rarity}` as keyof typeof ti.quality];
                return (
                  <li class:list={["qcard", `q${q.rarity}`]}>
                    <div class="qhead"><GameIcon name={`quality-${q.rarity}`} /><span class="qname">{qname}</span></div>
                    <div class="qart">{icon ? <img src={icon.src} width={icon.width * 2} height={icon.height * 2} alt="" class="qimg" loading="lazy" decoding="async" /> : <GameIcon name={`cat-${item.category}`} scale={4} />}</div>
                    <ul class="qstats">
                      {qualityKeys.map((k) => {
                        const n = q.stats[k];
                        if (!n) return <li class="none"><GameIcon name={`stat-${k}`} /><span class="sr-only">{statLabel(k)[lang]}</span><span>—</span></li>;
                        const gains = Object.fromEntries(CLASS_KEYS.map((c) => [c, (q.classes?.[c]?.[k] ?? n) - (q0.classes?.[c]?.[k] ?? q0.stats[k] ?? 0)]));
                        const base = n - (q0.stats[k] ?? 0);
                        const gainAttrs: Record<string, string> = { "data-v-base": base ? signed(base) : "" };
                        for (const [c, g] of Object.entries(gains)) gainAttrs[`data-v-${c}`] = g ? signed(g) : "";
                        return (
                          <li>
                            <GameIcon name={`stat-${k}`} /><span class="sr-only">{statLabel(k)[lang]}</span>
                            <StatValue value={n} variants={classVariants(k, q)} />
                            {q.rarity > 0 && (base || Object.values(gains).some(Boolean)) && <span class="gainwrap"><span class="gain" {...gainAttrs}>{base ? signed(base) : ""}</span><span class="sr-only"> {ti.gainOver}</span></span>}
                          </li>
                        );
                      })}
                      <li class="meta"><GameIcon name="stat-weight" /><span class="sr-only">{ti.weight}</span><span class="num">{oz(q.weight, lang)}</span></li>
                      {v.lifetime && <li class="meta"><GameIcon name="time" /><span class="sr-only">{ti.secondsCol}</span><span class="num">{q.lifetime ?? "—"} s</span></li>}
                    </ul>
                  </li>
                );
              })}
            </ol>
          </section>
        )}

        {(src.drops.length > 0 || src.shops.length > 0 || src.quests.length > 0 || src.map.length > 0 || src.recipes.length > 0 || src.conjured.length > 0 || src.leftover.length > 0) && (
          <section class="block" aria-labelledby="h-where">
            <h2 id="h-where">{ti.whereTitle}</h2>
            <div class="panels">
              {src.drops.length > 0 && (
                <ListPanel title={ti.dropsTitle} count={src.drops.length} gicon="src-drop" id="drops" note={anyQualityDrop ? ti.qualityNote : undefined}>
                  {src.drops.map((d) => (
                    <ListRow>
                      <EntityLink to={d.monster} iconSize={40} />
                      {(() => {
                        const ap = STUB_BY_REF.get(d.monster)?.appears;
                        if (!ap) return null;
                        return (
                          <Fragment slot="sub">
                            <span class="appears" data-appears={ap.how}>
                              {ap.how === "timed" && <><GameIcon name="time" scale={1} />{ti.appearsTimed}</>}
                              {ap.how === "placed" && <><GameIcon name="src-map" scale={1} />{ti.appearsPlaced} {placeText(ap.where.place)} <MapLink variant="inline" href={ap.where.link} entity={d.monster} label={ti.mapLink} /></>}
                              {ap.how === "lever" && <>{ti.appearsLever} <EntityLink to={ap.place} icon={false} /> <MapLink variant="inline" href={ap.where.link} entity={d.monster} label={ti.mapLink} /></>}
                              {ap.how === "travel" && <>{ti.appearsTravel} <EntityLink to={ap.via} iconSize={22} /></>}
                            </span>
                          </Fragment>
                        );
                      })()}
                      <Fragment slot="end">
                        <span class="qslot">{d.quality && <span class="qchip" title={ti.qualityYes}><GameIcon name="quality-any" /><span class="sr-only">{ti.qualityYes}</span></span>}</span>
                        <Value kind="amount" n={d.amount[0] === d.amount[1] ? d.amount[0] : `${d.amount[0]}–${d.amount[1]}`} lang={lang} noIcon />
                        <TierBadge tier={d.tier} />
                      </Fragment>
                    </ListRow>
                  ))}
                </ListPanel>
              )}
              {shopsOpen.length > 0 && (
                <ListPanel title={ti.shopsTitle} count={shopsOpen.length} gicon="src-shop" id="shops">
                  {shopsOpen.map((s) => (
                    <ListRow>
                      <EntityLink to={s.npc} iconSize={40} />
                      {s.where && <Fragment slot="sub"><span>{placeText(s.where.place)}</span><MapLink variant="inline" href={s.where.link} entity={s.npc} label={ti.mapLink} /></Fragment>}
                      <Fragment slot="end">
                        <Value kind="gold" n={s.price} lang={lang} best={s.price === Math.min(...shopsOpen.map((x) => x.price)) && shopsOpen.some((x) => x.price !== s.price)} />
                        {s.stock.kind === "unlimited" ? <Value kind="stockUnlimited" lang={lang} /> : s.stock.kind === "limited" ? <Value kind="stock" n={s.stock.n ?? 0} lang={lang} /> : <Value kind="blackMarket" n={s.stock.n ?? 0} lang={lang} />}
                      </Fragment>
                    </ListRow>
                  ))}
                </ListPanel>
              )}
              {shopsGated.length > 0 && (
                <Spoiler title={shopsOpen.length ? ti.spoilerShop : ti.spoilerShopOnly}>
                  <ul class="plain gated" data-section="shops-after-quest">
                    {shopsGated.map((s) => <li><EntityLink to={s.npc} /> · <Value kind="gold" n={s.price} lang={lang} />{s.where && <> · <MapLink variant="inline" href={s.where.link} entity={s.npc} label={ti.mapLink} /></>}{s.afterQuests.length > 0 && <span class="q">{ti.afterQuest}: {s.afterQuests.map((q, i) => <>{i > 0 && ` ${ti.or} `}<EntityLink to={q} /></>)}</span>}</li>)}
                  </ul>
                </Spoiler>
              )}
              {src.quests.length > 0 && (
                <Spoiler title={ti.spoilerQuests}>
                  <ul class="plain">{src.quests.map((q) => <li><EntityLink to={q.quest} />{q.amount > 1 && <> <Value kind="amount" n={q.amount} lang={lang} /></>}</li>)}</ul>
                </Spoiler>
              )}
              {src.recipes.length > 0 && (
                <ListPanel title={ti.recipesTitle} count={src.recipes.length} gicon="src-craft" id="recipes">
                  {src.recipes.map((r: Recipe) => (
                    <ListRow>
                      <TipTag size="small" icon={`method-${r.method}`} tip={ti.methodTip[r.method]}>{ti.method[r.method]}</TipTag>
                      {r.ingredients.map((ing, i) => <>{i > 0 && <span class="plus">+</span>}<Ingredient ing={ing} lang={lang} /></>)}
                    </ListRow>
                  ))}
                </ListPanel>
              )}
              {src.leftover.length > 0 && (
                <ListPanel title={ti.leftoverTitle} count={src.leftover.length} gicon="src-leftover" id="leftover" note={ti.leftoverNote}>
                  {src.leftover.map((l) => <ListRow><EntityLink to={`item:${l.item}`} /></ListRow>)}
                </ListPanel>
              )}
              {src.map.length > 0 && (
                <ListPanel title={ti.mapTitle} count={src.map.length} gicon="src-map" id="map">
                  {src.map.slice(0, MAP_SHOWN).map((m) => (
                    <ListRow>
                      <span>{placeText(m.place)}</span>
                      <Fragment slot="end"><MapLink variant="inline" href={m.link} entity={`item:${item.id}`} label={ti.mapLink} /></Fragment>
                    </ListRow>
                  ))}
                  {src.map.length > MAP_SHOWN && (
                    <li class="more-rows">
                      <details>
                        <summary>{fill(ti.mapMore, { n: src.map.length - MAP_SHOWN })}</summary>
                        <ul>
                          {src.map.slice(MAP_SHOWN).map((m) => (
                            <ListRow>
                              <span>{placeText(m.place)}</span>
                              <Fragment slot="end"><MapLink variant="inline" href={m.link} entity={`item:${item.id}`} label={ti.mapLink} /></Fragment>
                            </ListRow>
                          ))}
                        </ul>
                      </details>
                    </li>
                  )}
                </ListPanel>
              )}
              {src.conjured.length > 0 && (
                <ListPanel title={ti.conjuredTitle} gicon="src-conjure" id="conjured">
                  {src.conjured.map((c) => <ListRow><EntityLink to={c.spell} /><Fragment slot="end"><span class="vanish"><GameIcon name="time" />{fill(ti.conjuredNote, { n: c.seconds })}</span></Fragment></ListRow>)}
                </ListPanel>
              )}
            </div>
            {anyQualityDrop && (
              <div class="dq">
                <h3>{ti.dropQualityTitle}</h3>
                <p class="muted">{ti.dropQualityIntro}</p>
                <ul class="odds" data-section="drop-quality" data-pagefind-ignore="all">
                  {ITEMS.dropQuality.map((q) => (
                    <li class={`odd q${q.rarity}`}>
                      <GameIcon name={`quality-${q.rarity}`} scale={3} />
                      <span class="otext">
                        <span class="qname">{ti.quality[`q${q.rarity}` as keyof typeof ti.quality]}</span>
                        <span class="num">{oneInText(q, ti, lang)}</span>
                        <span class="rare" aria-hidden="true"><span style={`width:${Math.round(Math.min(1, Math.log10(Math.max(2, q.oneIn)) / 3) * 100)}%`}></span></span>
                      </span>
                    </li>
                  ))}
                </ul>
                <p class="muted small">{ti.rarerNote}</p>
              </div>
            )}
          </section>
        )}

        {(src.buyers.length > 0 || item.uses.recipes.length > 0 || item.uses.leavesEmpty.length > 0 || item.uses.questsRequire.length > 0 || item.rune || runesForThis.length > 0 || item.forgeable || ingotSteps.length > 0 || spells.length > 0) && (
          <section class="block" aria-labelledby="h-use">
            <h2 id="h-use">{ti.useTitle}</h2>
            <div class="panels">
              {item.rune && (
                <ListPanel title={ti.runeFits} gicon="rune" id="rune">
                  <ListRow><span class="fits">{item.rune.fits.map((f) => <span class="fit"><IconSlot icon={SUB_ICON.get(f.key) ?? null} kind="item" size={32} framed={false} /><span>{f[lang]}</span></span>)}</span></ListRow>
                  {item.rune.fitsItems.length > 0 && <ListRow><span class="links" data-flow>{item.rune.fitsItems.map((id) => <><EntityLink to={`item:${id}`} />{" "}</>)}</span></ListRow>}
                </ListPanel>
              )}
              {runesForThis.length > 0 && (
                <ListPanel title={ti.runesForThis} count={runesForThis.length} gicon="rune" id="runes">
                  <ListRow><span class="links" data-flow>{runesForThis.map((r) => <><EntityLink to={`item:${r.id}`} />{" "}</>)}</span></ListRow>
                </ListPanel>
              )}
              {spells.length > 0 && (
                <ListPanel title={ti.spellTitle} gicon="stat-magic" id="spell">
                  {spells.map((s) => <ListRow><EntityLink to={s} /></ListRow>)}
                </ListPanel>
              )}
              {item.uses.recipes.length > 0 && (
                <ListPanel title={ti.usedInTitle} count={item.uses.recipes.length} gicon="src-craft" id="used-in">
                  {item.uses.recipes.map((r) => (
                    <ListRow>
                      <TipTag size="small" icon={`method-${r.method}`} tip={ti.methodTip[r.method]}>{ti.method[r.method]}</TipTag>
                      {r.ingredients.map((ing, i) => <>{i > 0 && <span class="plus">+</span>}<Ingredient ing={ing} lang={lang} /></>)}
                      <span class="plus">→</span><EntityLink to={`item:${r.result}`} />
                    </ListRow>
                  ))}
                </ListPanel>
              )}
              {item.uses.leavesEmpty.length > 0 && (
                <ListPanel title={ti.leavesTitle} gicon="src-leftover" id="leaves">
                  {item.uses.leavesEmpty.map((l) => <ListRow><EntityLink to={`item:${l.item}`} /></ListRow>)}
                </ListPanel>
              )}
              {buyersOpen.length > 0 && (
                <ListPanel title={ti.buyersTitle} count={buyersOpen.length} gicon="gold" id="buyers">
                  {buyersOpen.map((b) => (
                    <ListRow>
                      <EntityLink to={b.npc} iconSize={40} />
                      {b.where && <Fragment slot="sub"><span>{placeText(b.where.place)}</span><MapLink variant="inline" href={b.where.link} entity={b.npc} label={ti.mapLink} /></Fragment>}
                      <Fragment slot="end"><Value kind="gold" n={b.price} lang={lang} best={b.price === Math.max(...buyersOpen.map((x) => x.price)) && buyersOpen.some((x) => x.price !== b.price)} /></Fragment>
                    </ListRow>
                  ))}
                </ListPanel>
              )}
              {buyersGated.length > 0 && (
                <Spoiler title={buyersOpen.length ? ti.spoilerBuyer : ti.spoilerBuyerOnly}>
                  <ul class="plain gated" data-section="buyers-after-quest">
                    {buyersGated.map((b) => <li><EntityLink to={b.npc} /> · <Value kind="gold" n={b.price} lang={lang} />{b.where && <> · <MapLink variant="inline" href={b.where.link} entity={b.npc} label={ti.mapLink} /></>}{b.afterQuests.length > 0 && <span class="q">{ti.afterQuest}: {b.afterQuests.map((q, i) => <>{i > 0 && ` ${ti.or} `}<EntityLink to={q} /></>)}</span>}</li>)}
                  </ul>
                </Spoiler>
              )}
              {item.uses.questsRequire.length > 0 && (
                <Spoiler title={ti.spoilerQuestNeed}>
                  <ul class="plain">{item.uses.questsRequire.map((q) => <li><EntityLink to={q.quest} /></li>)}</ul>
                </Spoiler>
              )}
            </div>
            {item.forgeable && (
              <div class="forge" id="forging" data-section="forging">
                <h3>{ti.forging}</h3>
                <p class="muted">{ti.forgingIntro}</p>
                <div class="table-wrap">
                  <table class="qtable">
                    <thead><tr><th scope="col">{ti.qualityCol}</th><th scope="col"><span class="hcell"><GameIcon name="anvil" fit={18} />{ti.forgingTakes}</span></th><th scope="col" class="r"><span class="hcell"><GameIcon name="plus" fit={18} />{ti.forgingUpgrade}</span></th><th scope="col" class="r"><span class="hcell"><GameIcon name="minus" fit={18} />{ti.forgingBreak}</span></th></tr></thead>
                    <tbody>
                      {ITEMS.forging.map((f) => (
                        <tr>
                          <th scope="row"><span class="fstep"><span class={`fq q${f.from}`}><GameIcon name={`quality-${f.from}`} /><span class="qname">{ti.quality[`q${f.from}` as keyof typeof ti.quality]}</span></span><span class="farrow" aria-hidden="true">➜</span><span class={`fq q${f.from + 1}`}><GameIcon name={`quality-${f.from + 1}`} /><span class="qname">{ti.quality[`q${f.from + 1}` as keyof typeof ti.quality]}</span></span></span></th>
                          <td><span class="num">{f.count} ×</span> <EntityLink to={`item:${f.ingot}`} iconSize={32} /></td>
                          <td class="r num">{oneInText(f.upgrade, ti, lang)}</td>
                          <td class="r num">{oneInText(f.bothBreak, ti, lang)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <p class="muted small">{ti.forgingElse} {ti.forgingPoints}</p>
              </div>
            )}
            {ingotSteps.length > 0 && (
              <Callout type="tip" title={ti.forging}>
                <p>{ti.ingotFor}: {ingotSteps.map((f) => `${ti.quality[`q${f.from}` as keyof typeof ti.quality]} (${f.count}×)`).join(", ")}.</p>
              </Callout>
            )}
          </section>
        )}

        {appears.length > 0 && (
          <section class="block" aria-labelledby="h-appears" data-section="appears">
            <h2 id="h-appears">{t.appearsHeading}</h2>
            <div class="panels">
              {appears.map((s) => (
                <ListPanel title={t.appearsTitle[s.kind] ?? t.kindPlural[s.kind]} count={s.refs.length} id={`appears-${s.kind}`}>
                  {s.refs.map((r) => <ListRow><EntityLink to={r} /></ListRow>)}
                </ListPanel>
              ))}
            </div>
          </section>
        )}

        {similar.length > 0 && (
          <section class="block" aria-labelledby="h-similar" data-pagefind-ignore>
            <h2 id="h-similar">{ti.similarTitle}</h2>
            <div class="similar">
              {similar.map((o) => {
                const ov = primaryVersion(o);
                return (
                  <Card href={registry.url(`item:${o.id}`, lang)!} title={displayName(o.name, "item", lang).name} kicker={o.subtype[lang]} layout="row">
                    <IconSlot slot="emblem" icon={ov.icon && ov.iconSize ? { src: ov.icon, width: ov.iconSize[0], height: ov.iconSize[1], pixel: true } : null} kind="item" size={56} />
                    {Object.values(ov.stats).some(Boolean) ? <StatChips stats={ov.stats} lang={lang} max={2} /> : o.value.npcPays ? <span class="paysline">{ti.sellValue} <Value kind="gold" n={o.value.npcPays} lang={lang} /></span> : ti.noStats}
                  </Card>
                );
              })}
            </div>
          </section>
        )}
      </div>

      <aside class="side">
        <InfoBox title={ti.stats}>
          {hasClasses && (
            <div class="switch">
              <span class="label"><GameIcon name="class" />{ti.classSwitch}</span>
              <VariantSwitch scope="item-page" compact label={ti.classSwitch} variants={[{ key: "base", label: ti.classBase, icon: "class" }, ...CLASS_KEYS.map((k) => ({ key: k, label: ti.classes[k], icon: `class-${k}` }))]} />
              <p class="traits-note" data-section="traits-note"><b class="vcap" data-vcap="item-page" aria-hidden="true">{ti.classBase}</b> · {ti.traitsNote}</p>
            </div>
          )}
          {statKeys.length > 0 ? (
            <ul class="statlist" data-section="statlist">
              {statKeys.map((k) => {
                const n = v.stats[k]!;
                const r = statRank(items, item, k);
                return (
                  <li class:list={["stat", { negative: n < 0 }]}>
                    <span class="sicon"><GameIcon name={`stat-${k}`} fit={30} /></span>
                    <span class="sname">{statLabel(k)[lang]}</span>
                    <StatValue value={n} variants={v.classes ? classVariants(k, v) : undefined} size="big" />
                    {r && <span class="rbar" aria-hidden="true"><span class:list={["rfill", { best: r.rank === 1 }]} style={`width:${Math.max(6, Math.round(r.share * 100))}%`}></span></span>}
                    {(r || n < 0) && (
                      <span class="smeta" data-pagefind-ignore>
                        {n < 0 && <span class="takes"><GameIcon name="minus" scale={1} />{ti.takesAway}</span>}
                        {r && <span class="rtext">{fill(r.rank === 1 ? ti.rankBest : ti.rankOf, { n: r.rank, of: r.of, group: item.subtype[lang] })}</span>}
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>
          ) : v.potion || v.food ? (
            <ul class="statlist" data-section="effect-stats">
              {v.potion && (
                <li class="stat">
                  <span class="sicon"><GameIcon name={v.potion.stat === "health" ? "stat-health" : "stat-mana"} fit={30} /></span>
                  <span class="sname">{v.potion.stat === "health" ? ti.healLabel : ti.manaLabel}</span>
                  <span class="sv num big">{v.potion.min}–{v.potion.max}</span>
                  <span class="smeta"><span class="rtext"><GameIcon name="time" scale={1} /> {fill(ti.overSeconds, { n: v.potion.seconds })}</span></span>
                </li>
              )}
              {v.food && (
                <li class="stat">
                  <span class="sicon"><GameIcon name="food" fit={30} /></span>
                  <span class="sname">{ti.feedsLabel}</span>
                  <span class="sv num big">{v.food.seconds} s</span>
                </li>
              )}
              {v.food && (Object.entries(v.food.buff) as [StatKey, number][]).map(([k, n]) => (
                <li class="stat">
                  <span class="sicon"><GameIcon name={`stat-${k}`} fit={30} /></span>
                  <span class="sname">{statLabel(k)[lang]}</span>
                  <StatValue value={n} size="big" />
                  <span class="smeta"><span class="rtext">{ti.buffWhile}</span></span>
                </li>
              ))}
            </ul>
          ) : <ul class="statlist" data-section="no-stats"><li class="stat nostats"><span class="sicon"><GameIcon name={`cat-${item.category}`} fit={30} /></span><span class="sname plain">{ti.noStatsWhy}</span></li></ul>}
          <ul class="facts">
            <li><span class="sicon"><GameIcon name="stat-weight" fit={28} /></span><span>{ti.weight}</span><b class="num">{oz(v.weight, lang)}</b></li>
            {v.stack > 1 && <li><span class="sicon"><GameIcon name="stack" fit={28} /></span><span>{ti.stack}</span><b class="num">{v.stack}</b></li>}
            {v.slots && <li><span class="sicon"><GameIcon name="slot-back" fit={28} /></span><span>{ti.slots}</span><b class="num">{v.slots}</b></li>}
            <li><span class="sicon"><GameIcon name="gold" fit={28} /></span><span>{ti.sellValue}</span><b>{item.value.npcPays ? <Value kind="gold" n={item.value.npcPays} lang={lang} size="big" noIcon /> : <span class="nil">—</span>}</b></li>
            {goldPerOz(item) && <li><span class="sicon"><GameIcon name="gold" fit={28} /></span><span>{ti.goldPerOz}</span><b><Value kind="goldoz" n={goldPerOz(item)!} lang={lang} size="big" noIcon /></b></li>}
          </ul>
          {states && <p slot="footer">{statesIntro}</p>}
          {statKeys.some((k) => statRank(items, item, k)) && <p slot="footer">{fill(ti.rankNote, { group: item.subtype[lang] })}</p>}
          {statKeys.some((k) => (v.stats[k] ?? 0) < 0) && <p slot="footer">{ti.negativeNote}</p>}
          {hasClasses && <p slot="footer">{ti.classNote}</p>}
        </InfoBox>
      </aside>
    </div>
  </div>
</PageShell>
<style>
  /* the hero (Codex): the item on a quiet dark slot, a soft green glow behind; no gold frame */
  .hero-icon { position: relative; isolation: isolate; padding: 6px; }
  .hero-icon::before { content: ""; position: absolute; inset: -30px; z-index: -1; border-radius: 50%; background: var(--hero-glow); }
  .hero-icon :global(.slot) { position: relative; border-radius: 16px; background: var(--hero-slot);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1), 0 14px 32px rgba(0, 0, 0, 0.4); }
  .hero-icon :global(.slot img) { filter: drop-shadow(0 8px 12px rgba(0, 0, 0, 0.45)); }
  @media (max-width: 640px) { .hero-icon::before { inset: -14px; } }
  .kicker { margin: 0; font: 700 var(--fs-xs) / 1 var(--font-body); letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-text); }
  .alt { margin: 0; color: var(--banner-muted); font-size: var(--fs-lg); }
  .game-text { align-self: flex-start; margin: 4px 0 0; padding: 10px 14px; border-left: 3px solid var(--accent); background: var(--surface-2); border-radius: 0 var(--r-m) var(--r-m) 0;
    color: var(--banner-text); font-style: italic; max-width: 38rem; }
  .tags { position: relative; display: flex; flex-wrap: wrap; gap: 8px; }
  /* where three or four tags can't share one line, one per line (never two and one) */
  /* one per line, all as wide as the widest (an even column, not three widths) */
  @container foot (max-width: 679px) {
    .tags { display: inline-grid; grid-template-columns: minmax(0, max-content); }
    .tags :global(.tiptag) { display: block; }
    .tags :global(.tt) { width: 100%; }
  }
  .tags :global(.tag) { background: var(--banner-chip-bg); color: var(--banner-text); white-space: normal; }

  .layout { display: grid; gap: var(--s-6); grid-template-columns: minmax(0, 1fr); grid-template-areas: "hero" "side" "main"; }
  .hero-area { grid-area: hero; min-width: 0; }
  .main { grid-area: main; min-width: 0; container: main / inline-size; }
  .side { grid-area: side; min-width: 0; }
  @media (min-width: 1000px) {
    .layout { grid-template-columns: minmax(0, 1fr) 330px; grid-template-areas: "hero side" "main side"; align-items: start; column-gap: var(--s-6); row-gap: var(--s-7); }
    /* not sticky: a stats box is often taller than the screen, and a stuck one hides its last rows (price, weight) */
  }
  /* a narrow desktop (1000-1199): the main column is ~600 px, too narrow for the hero; it spans both columns there */
  @media (min-width: 1000px) and (max-width: 1199px) { .layout { grid-template-areas: "hero hero" "main side"; } }
  /* one rhythm (layout rules): 56 px between sections, 16 px from a section title to its content, 32 px between the
     groups of a section, 12 px from a group's title to its rows */
  .block + .block { margin-top: var(--s-7); }
  .block > h2 { margin-bottom: var(--s-4); }
  .block > .muted { margin: calc(-1 * var(--s-2)) 0 var(--s-4); }
  .muted { color: var(--text-muted); }
  .small { font-size: var(--fs-sm); }
  .panels { display: grid; gap: var(--s-5); }

  /* an item that changes when equipped: its two states side by side (stacked on a narrow column), the rules under */
  .states { display: grid; gap: 12px; grid-template-columns: minmax(0, 1fr); align-items: stretch; }
  @container main (min-width: 620px) { .states { grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); } }
  .state { display: grid; align-content: start; gap: 10px; padding: 14px 16px; border-radius: var(--r-l); background: var(--card-bg); border: var(--bw) solid var(--border); }
  .state.on { border-top: 3px solid var(--accent); }
  .slabel { margin: 0; font: 700 var(--fs-xs) / 1 var(--font-body); letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); }
  .state.on .slabel { color: var(--accent-text); }
  .shead { display: flex; align-items: center; gap: 12px; }
  .shead p { margin: 0; }
  .sarrow { align-self: stretch; display: grid; place-items: center; color: var(--text-faint); font-size: 1.25rem; }
  @container main (max-width: 619px) { .sarrow { transform: rotate(90deg); } }
  .nostat { display: flex; align-items: center; gap: 6px; margin: 0; font-size: var(--fs-sm); color: var(--text-muted); }
  .sfacts { display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 0; font-size: var(--fs-sm); }
  .sval { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; color: var(--heading); font-weight: 700; }
  .srules { list-style: none; margin: var(--s-4) 0 0; padding: 0; display: grid; gap: 10px; }
  .srules li { display: grid; grid-template-columns: 52px minmax(0, 1fr); column-gap: 12px; align-items: center; }
  .versions { display: grid; gap: 0; }
  .version { display: flex; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--row-border); }
  .version:first-child { padding-top: 4px; }
  /* many versions (a spellbook has 16): two columns on a wide column, half the height; an odd last one spans */
  @container main (min-width: 700px) {
    .versions:has(> :nth-child(5)) { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--s-5); }
    .versions:has(> :nth-child(5)) > .version:nth-child(2) { padding-top: 4px; }
    .versions:has(> :nth-child(5)) > .version:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }
  .version p { margin: 4px 0 0; }
  .vt { font-style: italic; color: var(--text-muted); }
  .vs { margin-top: 6px; }

  .effects { display: grid; gap: 10px; }
  .effect { display: flex; flex-direction: column; gap: 8px; margin: 0; padding: 4px 0; }
  .effect p { margin: 0; }
  p.effect { flex-direction: row; align-items: center; gap: 12px; }
  .effect :global(.icon) { color: var(--accent-text); }
  .eicon { display: inline-grid; place-items: center; width: 52px; height: 52px; flex: none; border-radius: 12px; background: var(--well); }
  .erow { display: flex; align-items: center; gap: 12px; }
  .buff { display: inline-flex; align-items: center; gap: 6px; }
  .fstep { display: inline-flex; flex-wrap: nowrap; align-items: center; gap: 6px 10px; white-space: nowrap; }
  .fq { display: inline-flex; align-items: center; gap: 6px; }
  .farrow { color: var(--text-faint); }
  .hcell { display: inline-flex; align-items: center; gap: 6px; }
  .buffs { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: var(--fs-sm); color: var(--text-muted); }

  .table-wrap { overflow-x: auto; border: var(--bw) solid var(--border); border-radius: var(--r-l); background: var(--card-bg); }
  .qtable { width: 100%; border-collapse: collapse; font-size: var(--fs-sm); }
  .qtable th, .qtable td { padding: 9px 12px; text-align: left; white-space: nowrap; }
  .qtable thead th { background: var(--surface-2); font-weight: 700; color: var(--text-muted); border-bottom: 1px solid var(--row-border); }
  .qtable tbody tr + tr > * { border-top: 1px solid var(--row-border); }
  .qtable .r { text-align: right; }
  /* a phone: each row a two-by-two grid (the step and the ingot, then the two odds), the header in the same grid above,
     so every column stays in view and keeps its label; no side-scroll */
  @container main (max-width: 839px) {
    .table-wrap { overflow: visible; }
    /* the step on two lines in every row (from, then "→ to"): every row the same height */
    .fstep { display: grid; grid-template-columns: auto 1fr; grid-template-areas: "from from" "arrow to"; justify-items: start; gap: 4px 6px; }
    .fstep > :first-child { grid-area: from; } .fstep > .farrow { grid-area: arrow; } .fstep > :last-child { grid-area: to; }
    .qtable, .qtable thead, .qtable tbody { display: block; }
    .qtable tr { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 4px; }
    .qtable th, .qtable td { white-space: normal; }
    .qtable .r { text-align: left; }
    .qtable thead th { border-bottom: 0; padding-top: 7px; padding-bottom: 7px; }
    .qtable thead tr { background: var(--surface-2); border-bottom: 1px solid var(--row-border); }
    .qtable tbody tr + tr > * { border-top: 0; }
    .qtable tbody tr + tr { border-top: 1px solid var(--row-border); }
    .qtable tbody td.r { padding-top: 0; }
    .qtable tbody td:not(.r) { display: flex; align-items: center; gap: 6px; }
    .qtable tbody td:not(.r) .num { white-space: nowrap; flex-shrink: 0; }
  }
  .qname { font-weight: 800; }
  .q0 { color: var(--quality-0); }
  .q1 { color: var(--quality-1); }
  .q2 { color: var(--quality-2); }
  .q3 { color: var(--quality-3); }
  .q4 { color: var(--quality-4); }
  .qchip { color: var(--magic); display: inline-flex; }
  :global(#drops .end) { display: grid; grid-template-columns: 24px 2.5rem 7.75rem; align-items: center; justify-items: end; gap: 10px; flex-wrap: nowrap; }
  :global(#drops .end .tier) { justify-self: stretch; }
  .qslot { display: inline-grid; place-items: center; width: 24px; }
  @media (max-width: 639px) {
    :global(#drops .end) { display: flex; gap: 10px; }
    .qslot:empty { display: none; }
  }

  .dq, .forge { margin-top: var(--s-5); }
  .dq h3, .forge h3 { margin-bottom: var(--s-2); font: 700 var(--fs-md) / 1.2 var(--font-body); }
  .dq > .muted, .forge > .muted { margin: 0 0 var(--s-3); }
  /* four odds: one column, two by two, or four in a row (never three and one) */
  .odds { list-style: none; margin: 0 0 6px; padding: 0; display: grid; gap: 10px; grid-template-columns: minmax(0, 1fr); }
  @container main (min-width: 440px) { .odds { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @container main (min-width: 800px) { .odds { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .odd { display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: var(--card-bg); border: var(--bw) solid var(--border);
    border-left: 4px solid currentColor; border-radius: var(--r-m); }
  .otext { display: grid; gap: 3px; min-width: 0; flex: 1; }
  .odd .num { color: var(--text); font-weight: 700; }
  .rare { display: block; height: 6px; border-radius: 3px; background: var(--surface-3); overflow: hidden; }
  .rare span { display: block; height: 100%; background: currentColor; border-radius: 3px; }

  /* the qualities: one card each, framed in the quality's colour, the item outlined as the game highlights it */
  /* the cards wrap (five across when there is room, two on a phone): every quality in view, no hidden side-scroll */
  /* five cards: five in a row, three and two, or two by two with the last across (never one alone in a half row) */
  .qcards { list-style: none; margin: 0; padding: 4px 0 10px; display: grid; gap: 12px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .qcards > :last-child:nth-child(odd) { grid-column: 1 / -1; }

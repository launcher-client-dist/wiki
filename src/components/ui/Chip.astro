---
/**
 * A pressable chip. As a filter in a DataTable: `filter="region" value="north"` (the table's script reads them).
 * With `href` it is a plain link styled as a chip.
 */
import Icon from "./Icon.astro";
import GameIcon from "./GameIcon.astro";
type Base = { pressed?: boolean; count?: number; href?: string; filter?: string; value?: string };
/** Never plain text: `icon`, `gicon` (the game's), or `plainBecause` (rare; listed by the site check). */
type Props = Base & (
  | { icon: Parameters<typeof Icon>[0]["name"]; gicon?: never; plainBecause?: never }
  | { gicon: string; icon?: never; plainBecause?: never }
  | { plainBecause: string; icon?: never; gicon?: never }
);
const { pressed = false, count, href, filter, value, icon, gicon, plainBecause } = Astro.props as Base & { icon?: Parameters<typeof Icon>[0]["name"]; gicon?: string; plainBecause?: string };
---
{href ? (
  <a class="chip" href={href} data-plain={plainBecause}>{icon && <Icon name={icon} size={14} />}{gicon && <GameIcon name={gicon} fit={18} />}<slot />{count !== undefined && <span class="count">{count}</span>}</a>
) : (
  <button class="chip" type="button" aria-pressed={pressed ? "true" : "false"} data-filter={filter} data-value={value} data-plain={plainBecause}>
    {icon && <Icon name={icon} size={14} />}{gicon && <GameIcon name={gicon} fit={18} />}<slot />{count !== undefined && <span class="count">{count}</span>}
  </button>
)}
<style>
  .chip {
    display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 12px; border-radius: var(--r-pill);
    border: var(--bw) solid var(--border); background: var(--surface); color: var(--text); text-decoration: none;
    font: 600 var(--fs-sm) / 1 var(--font-body); cursor: pointer; white-space: nowrap; box-shadow: var(--shadow-1);
    transition: transform var(--t-fast) var(--ease), box-shadow var(--t-fast) var(--ease), background var(--t-fast);
  }
  .chip:hover { background: var(--surface-2); color: var(--text); }
  .chip:active { transform: translateY(2px); box-shadow: 0 1px 0 var(--hard); }
  .chip[aria-pressed="true"] { background: var(--chip-on-bg); color: var(--chip-on-text); border-color: var(--hard); }
  .count { font: 600 0.6875rem / 1 var(--font-num); color: var(--text-faint); }
  .chip[aria-pressed="true"] .count { color: inherit; opacity: 0.8; }
</style>

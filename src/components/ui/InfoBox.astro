---
/**
 * The info box shell ("Ficha"): a titled block for an entity's key facts. Slots: `media` (an icon or render on top),
 * default (StatGrid, bars...), `actions` (buttons), `footer` (source line).
 */
interface Props {
  title: string;
  label?: string;
}
const { title, label } = Astro.props;
---
<aside class="infobox" aria-label={label ?? title}>
  <div class="head">{title}</div>
  {Astro.slots.has("media") && <div class="media"><slot name="media" /></div>}
  <slot />
  {Astro.slots.has("actions") && <div class="actions"><slot name="actions" /></div>}
  {Astro.slots.has("footer") && <div class="footer"><slot name="footer" /></div>}
</aside>
<style>
  .infobox { background: var(--card-bg); border: var(--bw) solid var(--hard); border-radius: var(--r-l); box-shadow: var(--shadow-2); overflow: hidden; }
  .head { padding: 16px 18px 12px; font: 700 var(--fs-lg) / 1 var(--font-body); color: var(--heading); border-bottom: 1px solid var(--row-border); }
  .media { padding: var(--s-4); background: var(--render-bg); border-bottom: 1px solid var(--row-border); display: grid; place-items: center; }
  .actions { display: grid; gap: 8px; padding: 14px 18px; border-top: 1px solid var(--row-border); }
  .footer { padding: 12px 18px 16px; font-size: var(--fs-xs); color: var(--text-faint); border-top: 1px solid var(--row-border); }
  .footer:empty { display: none; }
</style>

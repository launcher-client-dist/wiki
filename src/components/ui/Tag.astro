---
/** A small label: a fact, a region, a state. `tone="placeholder"` marks something provisional (dashed). */
import Icon from "./Icon.astro";
interface Props {
  tone?: "default" | "accent" | "sun" | "placeholder" | "danger";
  icon?: Parameters<typeof Icon>[0]["name"];
  title?: string;
}
const { tone = "default", icon, title } = Astro.props;
---
<span class:list={["tag", `tag--${tone}`]} title={title}>{icon && <Icon name={icon} size={14} />}<slot /></span>
<style>
  .tag {
    display: inline-flex; align-items: center; gap: 6px; padding: 4px 9px; border-radius: var(--r-s);
    font: 600 var(--fs-xs) / 1.2 var(--font-body); white-space: nowrap;
    background: var(--tag-bg); color: var(--tag-text); border: var(--bw) solid var(--border);
  }
  .tag--accent { background: var(--accent); color: var(--on-accent); border-color: var(--hard); }
  .tag--sun { background: var(--sun); color: var(--on-sun); border-color: var(--hard); font-weight: 800; }
  .tag--danger { background: transparent; color: var(--danger); border-color: currentColor; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.625rem; padding: 3px 6px; }
  .tag--placeholder { background: transparent; color: var(--text-faint); border-style: dashed; }
</style>

---
/**
 * "Ver no mapa": a link to the wiki's own map, in the same tab, on the spot's floor with a marker. `href` is a map link
 * from the data (turned into its spot through src/data/map/links.json; an unknown one fails the build), `entity` the
 * ref whose spots light up with it (the NPC of a shop row, the item of a map spot, the monster of its places).
 * Without either, the map's home.
 *   <MapLink variant="inline" href={s.where.link} entity={s.npc} label="ver no mapa" />
 */
import { ui } from "../../i18n/index.ts";
import { isLang, DEFAULT_LANG, type Lang } from "../../lib/i18n.ts";
import { mapHref, spotOf } from "../../lib/map/links.ts";
import Icon from "./Icon.astro";
interface Props {
  href?: string;
  entity?: string;
  variant?: "button" | "inline";
  label?: string;
}
const lang: Lang = isLang(Astro.params.lang) ? Astro.params.lang : DEFAULT_LANG;
const t = ui(lang);
const { href, entity, variant = "button", label = t.mapOpen } = Astro.props;
const url = mapHref(lang, href ? spotOf(href) : null, entity ?? null);
---
<a class:list={["maplink", `maplink--${variant}`]} href={url} data-maplink>
  <Icon name="map" size={variant === "button" ? 18 : 16} /><span>{label}</span>
</a>
<style>
  .maplink { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; font-weight: 700; }
  .maplink--button {
    height: 44px; padding: 0 16px; border-radius: var(--r-m); background: var(--accent); color: var(--on-accent);
    border: var(--bw) solid var(--hard); box-shadow: var(--shadow-1); transition: transform var(--t-fast) var(--ease), box-shadow var(--t-fast);
  }
  .maplink--button:hover { background: var(--accent-hover); color: var(--on-accent); }
  .maplink--button:active { transform: translateY(2px); box-shadow: var(--shadow-1); }
  .maplink--inline { color: var(--link); font-size: var(--fs-sm); }
  .maplink--inline:hover { color: var(--link-hover); text-decoration: underline; }
</style>

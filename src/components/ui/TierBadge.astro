---
/**
 * A drop frequency tier: its word and 1-5 pips, all in one neutral colour (never a %). Colour on the item pages means
 * an item's quality (Comum ... Lendário); a drop tier never borrows those colours, so the two never read alike.
 */
import { ui } from "../../i18n/index.ts";
import { isLang, DEFAULT_LANG, type Lang } from "../../lib/i18n.ts";
import { TIER_PIPS, type TierKey } from "../../lib/entities/tiers.ts";
interface Props {
  tier: TierKey;
  lang?: Lang;
}
const lang: Lang = Astro.props.lang ?? (isLang(Astro.params.lang) ? Astro.params.lang : DEFAULT_LANG);
const t = ui(lang);
const { tier } = Astro.props;
const lit = TIER_PIPS[tier];
---
<span class:list={["tier", `tier--${tier}`]} title={t.tierHint[tier]}>
  <span class="pips" aria-hidden="true">{[1, 2, 3, 4, 5].map((n) => <i class:list={{ on: n <= lit }} />)}</span>
  {t.tier[tier]}
</span>
<style>
  .tier {
    display: inline-flex; align-items: center; gap: 7px; height: 26px; padding: 0 9px 0 7px; border-radius: var(--r-s);
    font: 700 var(--fs-xs) / 1 var(--font-body); white-space: nowrap; color: var(--text);
    background: var(--surface-2); border: var(--bw) solid var(--border-strong);
  }
  .pips { display: inline-flex; gap: 2px; }
  .pips i { width: 4px; height: 10px; background: currentColor; opacity: 0.2; border-radius: 1px; }
  .pips i.on { opacity: 1; }
</style>

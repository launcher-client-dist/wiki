---
/** A highlighted note: info (default), tip or warn. The title defaults to the type's word. */
import { ui } from "../../i18n/index.ts";
import { isLang, DEFAULT_LANG } from "../../lib/i18n.ts";
import Icon from "./Icon.astro";
interface Props {
  type?: "info" | "tip" | "warn";
  title?: string;
}
const { type = "info", title } = Astro.props;
const t = ui(isLang(Astro.params.lang) ? Astro.params.lang : DEFAULT_LANG);
const word = { info: t.calloutInfo, tip: t.calloutTip, warn: t.calloutWarn }[type];
---
<aside class:list={["callout", `callout--${type}`]} aria-label={title ?? word}>
  <Icon name={type} size={20} />
  <div class="body">
    <strong class="title">{title ?? word}</strong>
    <div class="text"><slot /></div>
  </div>
</aside>
<style>
  .callout {
    --c: var(--callout-info);
    display: flex; gap: 12px; padding: 14px 16px; border-radius: var(--r-l); background: var(--callout-bg);
    border: var(--bw) solid var(--border); border-left: 6px solid var(--c); box-shadow: var(--shadow-1);
  }
  .callout--tip { --c: var(--callout-tip); }
  .callout--warn { --c: var(--callout-warn); }
  .callout > :global(.icon) { color: var(--c); margin-top: 2px; }
  .title { display: block; font-weight: 700; color: var(--heading); margin-bottom: 2px; }
  .text :global(p) { margin: 0; }
  .text :global(p + p) { margin-top: var(--s-2); }
</style>

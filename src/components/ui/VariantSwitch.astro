---
/**
 * A segmented switch that swaps values in place inside a scope (a class switcher, say): every element in the scope
 * with data-v-<variant> shows that text when the variant is picked (data-v-base by default); one whose text starts
 * with "−" gets the negative style. A value the variant changes is marked "changed" plus "up" or "down" (an arrow and
 * a short flash, none with reduced motion). Each variant can carry an icon (a GameIcon name), always beside its word.
 * Without JavaScript the base values stay.
 *   <VariantSwitch scope="item-stats" label="Classe" variants={[{ key: "base", label: "Base" }, { key: "knight", label: "Cavaleiro", icon: "class-knight" }]} />
 * `compact`: icon tabs in one row (every variant needs an icon); the words stay for screen readers and in the tooltip,
 * and the picked one's name shows in any element with data-vcap="<scope>" (a caption the page places).
 */
import GameIcon from "./GameIcon.astro";
interface Props {
  scope: string;
  label: string;
  variants: { key: string; label: string; icon?: string }[];
  compact?: boolean;
}
const { scope, label, variants, compact = false } = Astro.props;
---
<div class:list={["vswitch", { compact }]} role="radiogroup" aria-label={label} data-vswitch={scope} style={compact ? `--n:${variants.length}` : undefined}>
  {variants.map((v, i) => (
    <button type="button" role="radio" aria-checked={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-v={v.key} data-label={v.label} title={compact ? v.label : undefined}>
      {v.icon && <span class="vicon"><GameIcon name={v.icon} scale={2} /></span>}<span class:list={{ "sr-only": compact }}>{v.label}</span>
    </button>
  ))}
</div>
<script>
  const numberOf = (s: string) => parseFloat(s.replace("−", "-").replace(/[^\d.,-]/g, "").replace(/\./g, "").replace(",", "."));
  for (const sw of document.querySelectorAll<HTMLElement>("[data-vswitch]")) {
    const scope = document.getElementById(sw.dataset.vswitch!);
    const buttons = [...sw.querySelectorAll<HTMLButtonElement>("[data-v]")];
    const pick = (b: HTMLButtonElement, focus = false) => {
      const v = b.dataset.v!;
      for (const x of buttons) { const on = x === b; x.setAttribute("aria-checked", String(on)); x.tabIndex = on ? 0 : -1; }
      for (const cap of document.querySelectorAll<HTMLElement>(`[data-vcap="${sw.dataset.vswitch}"]`)) cap.textContent = b.dataset.label ?? "";
      for (const el of scope?.querySelectorAll<HTMLElement>("[data-v-base]") ?? []) {
        const base = el.getAttribute("data-v-base") ?? "";
        const text = el.getAttribute(`data-v-${v}`) ?? base;
        el.textContent = text;
        const changed = text !== base;
        const delta = changed ? numberOf(text) - numberOf(base) : 0;
        el.classList.toggle("neg", text.startsWith("−"));
        el.classList.toggle("changed", changed);
        el.classList.toggle("up", changed && delta > 0);
        el.classList.toggle("down", changed && delta < 0);
        if (changed) { el.classList.remove("flash"); void el.offsetWidth; el.classList.add("flash"); }
      }
      if (focus) b.focus();
    };
    buttons.forEach((b, i) => {
      b.addEventListener("click", () => pick(b));
      b.addEventListener("keydown", (e) => {
        const d = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        pick(buttons[(i + d + buttons.length) % buttons.length]!, true);
      });
    });
  }
</script>
<style>
  .vswitch { display: flex; flex-wrap: wrap; gap: 4px; padding: 4px; border: var(--bw) solid var(--border); border-radius: var(--r-l); background: var(--surface-2); }
  button { flex: 1 1 auto; display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 40px; padding: 4px 12px 4px 6px;
    border: 0; border-radius: var(--r-m); background: none; color: var(--text-muted); font: 700 var(--fs-sm) / 1 var(--font-body); cursor: pointer; white-space: nowrap; }
  button:hover { color: var(--text); background: var(--hover-strong); }
  /* Codex: the selected class in the one accent (yellow is kept for "the best") */
  button[aria-checked="true"] { background: var(--accent); color: var(--on-accent); box-shadow: var(--shadow-1); }
  /* compact: one row of equal icon tabs, never wrapping (no tab left alone on a line) */
  .compact { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); flex-wrap: nowrap; }
  .compact button { padding: 4px; min-height: 46px; }
  .vicon { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 8px; background: var(--well); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1); }
</style>

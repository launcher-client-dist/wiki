---
/**
 * A tag that explains itself: an icon (a GameIcon name) and its words, plus a tooltip that opens on hover, keyboard
 * focus and tap or click (a toggle, so it works where a tap doesn't focus a button; Escape or a click elsewhere closes
 * it). The tag is a button described by the tip: never `title` alone. The tip opens upward, so a container that clips
 * at its bottom edge never cuts it; on a phone it spans the tags' row (the row is its positioning box).
 *   <TipTag icon="slot-hands" iconScale={1} tip="Onde se equipa...">Espaço: Mãos</TipTag>
 */
import GameIcon from "./GameIcon.astro";
import { stableId } from "../../lib/ids.ts";
interface Props {
  tip: string;
  icon?: string;
  iconScale?: number;
  tone?: "default" | "sun";
  /** "small": inside a list row (a recipe's method). */
  size?: "normal" | "small";
}
const { tip, icon, iconScale = 2, tone = "default", size = "normal" } = Astro.props;
// a stable id (the same build gives the same page): from the tip's own text
let h = 0;
for (const c of tip) h = (h * 31 + c.charCodeAt(0)) >>> 0;
const id = stableId(Astro.request, `tip-${h.toString(36)}`);
---
<span class:list={["tiptag", `tone-${tone}`, { small: size === "small" }]} data-tiptag>
  <button type="button" class="tt" aria-describedby={id} aria-expanded="false">
    {icon && <span class="ti"><GameIcon name={icon} fit={size === "small" ? 18 : 28} scale={iconScale} /></span>}
    <span class="tw"><slot /></span>
    <span class="q" aria-hidden="true">?</span>
  </button>
  <span role="tooltip" id={id} class="tip">{tip}</span>
</span>
<script>
  const close = (except?: Element) => {
    for (const t of document.querySelectorAll<HTMLElement>("[data-tiptag].open")) {
      if (t === except) continue;
      t.classList.remove("open");
      t.querySelector("button")?.setAttribute("aria-expanded", "false");
    }
  };
  for (const t of document.querySelectorAll<HTMLElement>("[data-tiptag]")) {
    const b = t.querySelector("button")!;
    b.addEventListener("click", (e) => {
      e.stopPropagation();
      close(t);
      const open = t.classList.toggle("open");
      b.setAttribute("aria-expanded", String(open));
    });
  }
  document.addEventListener("click", () => close());
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
</script>
<style>
  .tiptag { position: relative; display: inline-flex; }
  .tt { display: inline-flex; align-items: center; gap: 8px; min-height: 38px; padding: 4px 12px 4px 4px; border-radius: var(--r-m);
    border: var(--bw) solid var(--border); background: var(--surface-2); color: var(--text); font: 600 var(--fs-sm) / 1.1 var(--font-body);
    cursor: help; text-align: left; transition: border-color var(--t-fast), background var(--t-fast); }
  /* Codex: no yellow tag ("sun" is for "the best"): the sun tone reads as the accent outline */
  .tone-sun .tt { border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); }
  .small .tt { min-height: 30px; padding: 2px 9px 2px 3px; gap: 6px; font-size: var(--fs-xs); }
  .small .ti { min-width: 22px; min-height: 22px; }
  .small .q { width: 13px; height: 13px; font-size: 9px; }
  .ti { display: inline-grid; place-items: center; min-width: 30px; min-height: 30px; border-radius: 6px; background: var(--well); }
  .q { display: inline-grid; place-items: center; width: 16px; height: 16px; border-radius: 50%; font-size: 11px; color: var(--text-muted);
    border: 1px solid currentColor; opacity: 0.8; }
  .tt:hover, .tt:focus-visible, .open .tt { border-color: var(--focus); background: var(--surface-3); }
  .tip { position: absolute; z-index: 30; left: 0; bottom: calc(100% + 8px); width: max-content; max-width: min(300px, calc(100vw - 32px)); padding: 10px 12px;
    border-radius: var(--r-m); border: var(--bw) solid var(--border); background: var(--popover-bg); color: var(--text);
    font: 500 var(--fs-sm) / 1.4 var(--font-body); box-shadow: var(--shadow-2); visibility: hidden; opacity: 0; transition: opacity 0.12s; pointer-events: none; }
  .tiptag:hover .tip, .tt:focus-visible + .tip, .open .tip { visibility: visible; opacity: 1; }
  @media (max-width: 640px) {
    .tiptag { position: static; }
    .tip { left: 0; right: 0; width: auto; max-width: none; }
  }
  @media (prefers-reduced-motion: reduce) { .tip { transition: none; } }
</style>

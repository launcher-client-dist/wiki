---
/**
 * A titled block of rows (ListRow children): the "dropped by", "sold by", "recipes" lists of an entity page. An icon
 * and a count beside the title; `note` under it.
 */
import Icon from "./Icon.astro";
import GameIcon from "./GameIcon.astro";
interface Props {
  title: string;
  count?: number;
  icon?: Parameters<typeof Icon>[0]["name"];
  /** One of the game's own icons (a GameIcon name), shown instead of `icon`. */
  gicon?: string;
  note?: string;
  id?: string;
}
const { title, count, icon, gicon, note, id } = Astro.props;
---
<section class="lpanel" id={id} data-section={id}>
  <h3>{gicon ? <span class="gi"><GameIcon name={gicon} fit={27} /></span> : icon && <Icon name={icon} size={18} />}<span>{title}</span>{count !== undefined && <span class="n">{count}</span>}</h3>
  {note && <p class="note">{note}</p>}
  <ul><slot /></ul>
</section>
<style>
  /* Codex: a section, not a box: a heading with a thin divider, the rows below */
  .lpanel { min-width: 0; }
  h3 { display: flex; gap: 10px; align-items: center; margin: 0; padding: 0 0 10px; font: 700 var(--fs-md) / 1.2 var(--font-body); color: var(--heading);
    border-bottom: 1px solid var(--row-border); text-shadow: none; }
  h3 :global(.icon) { color: var(--accent-text); }
  .gi { display: inline-grid; place-items: center; width: 32px; height: 32px; border-radius: 8px; background: var(--well); }
  /* the count: a readable pill, not a faint digit */
  .n { display: inline-grid; place-items: center; min-width: 24px; height: 22px; padding: 0 7px; border-radius: var(--r-pill);
    font: 700 var(--fs-xs) / 1 var(--font-num); color: var(--text); background: var(--surface-3); }
  .note { margin: 0; padding: 10px 0 0; font-size: var(--fs-sm); color: var(--text-muted); }
  ul { list-style: none; margin: 0; padding: 2px 0 0; }
</style>
